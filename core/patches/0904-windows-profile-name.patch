@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/views/frame/browser_window_property_manager_win.h"
 
+#include "components/fury/fury_config.h"
+
 #include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/strings/utf_string_conversions.h"
@@ -104,6 +106,31 @@ void BrowserWindowPropertyManager::UpdateWindowProperties() {
                                             &pinned_name, &icon_path);
     command_line_string = command_line.GetCommandLineString();
   }
+  // Fury patch 0904: the taskbar names the profile, and the window cannot be
+  // pinned.
+  //
+  // A pinned browser window relaunches through its relaunch command, which
+  // is this executable with no Fury config: a profile directory opened with
+  // no persona and no proxy, from the operator's own address. So a window
+  // of a Fury profile is never pinnable, whatever else is set, and the name
+  // Windows shows for the group is the profile's (RelaunchDisplayNameResource
+  // is only read beside a RelaunchCommand, so one is given; with pinning
+  // prevented it is never run).
+  const fury::FuryConfig* fury_config = fury::FuryConfig::Get();
+  std::optional<std::string> fury_name =
+      fury_config ? fury_config->GetString("window.profileName") : std::nullopt;
+  if (fury_config) {
+    ui::win::PreventWindowFromPinning(hwnd_);
+  }
+  if (fury_name && !fury_name->empty() &&
+      (browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL ||
+       browser->GetType() == BrowserWindowInterface::Type::TYPE_POPUP)) {
+    pinned_name = base::UTF8ToWide(*fury_name);
+    if (command_line_string.empty()) {
+      command_line_string =
+          base::CommandLine::ForCurrentProcess()->GetCommandLineString();
+    }
+  }
   ui::win::SetAppDetailsForWindow(app_id, icon_path, 0, command_line_string,
                                   pinned_name, hwnd_);
 }
