+                           int nh,
+                           int cw,
+                           int ch,
+                           bool bgra,
+                           bool opaque_blends = true) {
+  auto usable = [&](int x, int y) {
+    return x >= 0 && y >= 0 && x < cw && y < ch && x >= ox && y >= oy &&
+           x < ox + ow && y < oy + oh;
+  };
+  auto at = [&](int x, int y) -> size_t {
+    return static_cast<size_t>(y - oy) * row_bytes +
+           static_cast<size_t>(x - ox) * 4;
+  };
+  auto equal = [&](size_t a, size_t b) {
+    return original[a] == original[b] && original[a + 1] == original[b + 1] &&
+           original[a + 2] == original[b + 2] &&
+           original[a + 3] == original[b + 3];
+  };
+  static constexpr std::array<std::pair<int, int>, 4> kNeighbours = {
+      {{-1, 0}, {1, 0}, {0, -1}, {0, 1}}};
+  for (int y = ny; y < ny + nh; ++y) {
+    for (int x = nx; x < nx + nw; ++x) {
+      if (!usable(x, y)) {
+        continue;
+      }
+      const size_t p = at(x, y);
+      if (p + 3 >= original.size() || p + 3 >= noised.size()) {
+        continue;
+      }
+      const uint8_t alpha = original[p + 3];
+      if (alpha == 0) {
+        continue;
+      }
+      bool all_equal = true;
+      bool none_equal = true;
+      bool all_opaque = true;
+      for (const auto& d : kNeighbours) {
+        const int qx = x + d.first;
+        const int qy = y + d.second;
+        if (!usable(qx, qy)) {
+          continue;
+        }
+        const size_t q = at(qx, qy);
+        if (q + 3 >= original.size()) {
+          continue;
+        }
+        const bool same = equal(p, q);
+        all_equal = all_equal && same;
+        none_equal = none_equal && !same;
+        all_opaque = all_opaque && original[q + 3] == 255;
+      }
+      if (all_equal) {
+        continue;
+      }
+      const uint64_t h = Mix(seed ^ (static_cast<uint64_t>(x) * 0x100000001b3ULL) ^
+                             (static_cast<uint64_t>(y) << 32));
+      if (h & 1) {
+        continue;
+      }
+      if (alpha < 255) {
+        if (!none_equal) {
+          continue;
+        }
+        // Coverage, one step, and the SAME colour at the new coverage: the
+        // premultiplied channels scale with alpha, as they would out of a
+        // rasteriser that covered this pixel a little more or less.
+        //
+        // The first version only clamped RGB to the new alpha, which keeps
+        // the premultiplied numbers and so changes the colour: getImageData
+        // unpremultiplies, and a pixel at alpha 70 moved 2-4 levels off the
+        // fill colour, one at alpha 1 -> 2 moved 127. verify-0030 caught it on
+        // the first macOS 155 build (30.09.2026); no Windows run had executed
+        // that script.
+        const int next = (h & 2) ? alpha + 1 : alpha - 1;
+        const int a2 = next < 1 ? 1 : next > 254 ? 254 : next;
+        noised[p + 3] = static_cast<uint8_t>(a2);
+        for (size_t c = 0; c < 3; ++c) {
+          const int scaled = (original[p + c] * a2 + alpha / 2) / alpha;
+          noised[p + c] = static_cast<uint8_t>(scaled > a2 ? a2 : scaled);
+        }
+        if (!RoundTrips(noised[p], a2) || !RoundTrips(noised[p + 1], a2) ||
+            !RoundTrips(noised[p + 2], a2)) {
+          for (size_t c = 0; c < 4; ++c) {
+            noised[p + c] = original[p + c];
+          }
+        }
+      } else if (opaque_blends && none_equal && all_opaque) {
+        const size_t colour = (h >> 3) % 3;
+        const size_t channel = (bgra && colour != 1) ? 2 - colour : colour;
+        uint8_t& v = noised[p + channel];
+        v = ((h >> 5) & 1) ? (v < 255 ? v + 1 : v - 1) : (v > 0 ? v - 1 : v + 1);
+      }
+    }
+  }
+}
+
+// Writes into `dst` the pixels the noise moved, and nothing else. `original`
+// and `noised` are premultiplied, `src_row_bytes` apart, and the pixel at
+// (sx, sy) in them is the first of `dst`, which holds w x h pixels of the same
+// 8-bit layout, `dst_row_bytes` apart, unpremultiplied when `dst_unpremul`.
+//
+// `dst` already holds what the browser itself read back, and every pixel the
+// noise left alone has to stay exactly that. Converting the whole region from
+// premultiplied ourselves did not: a flat rgba(102,102,102,0.4) fill is
+// premultiplied 41 at alpha 102, exactly between 102 and 103 unpremultiplied,
+// and Chrome reads 103 where Skia's conversion on the CPU gives 102. Every
+// half-transparent pixel of a noised canvas moved (7103 of 7200 in
+// verify-0030's veil scene, core 158, 26.11.2026).
+inline void WriteNoised(base::span<const uint8_t> original,
+                        base::span<const uint8_t> noised,
+                        size_t src_row_bytes,
+                        int sx,
+                        int sy,
+                        int w,
+                        int h,
+                        uint8_t* dst,
+                        size_t dst_row_bytes,
+                        bool dst_unpremul) {
+  for (int y = 0; y < h; ++y) {
+    for (int x = 0; x < w; ++x) {
+      const size_t s = static_cast<size_t>(sy + y) * src_row_bytes +
+                       static_cast<size_t>(sx + x) * 4;
+      if (s + 3 >= original.size() || s + 3 >= noised.size()) {
+        continue;
+      }
+      if (original[s] == noised[s] && original[s + 1] == noised[s + 1] &&
+          original[s + 2] == noised[s + 2] &&
+          original[s + 3] == noised[s + 3]) {
+        continue;
+      }
+      // SAFETY: (x, y) lies inside the w x h pixels `dst` holds.
+      uint8_t* d = UNSAFE_BUFFERS(dst + static_cast<size_t>(y) * dst_row_bytes +
+                                  static_cast<size_t>(x) * 4);
+      const int a = noised[s + 3];
+      for (size_t c = 0; c < 3; ++c) {
+        UNSAFE_BUFFERS(d[c]) = static_cast<uint8_t>(
+            dst_unpremul && a < 255 ? Unpremul(noised[s + c], a) : noised[s + c]);
+      }
+      UNSAFE_BUFFERS(d[3]) = static_cast<uint8_t>(a);
+    }
+  }
+}
+
+// Noises the pixels an encoder is about to read, into `out`, in the encoder's
+// own format. False, with nothing written, when there is nothing to noise in
+// them (not 8-bit RGBA or BGRA).
+//
+// The encoder's pixels may be unpremultiplied: ImageDataBuffer converts them
+// before encoding and CanvasAsyncBlobCreator leaves it to the encoder, and
+// which of the two does what has changed between milestones. Noising
+// unpremultiplied numbers as if they were premultiplied clamped each channel
+// to alpha, and a PNG's half-transparent pixels came out a different colour
+// from getImageData's -- (0, 106, 149, 12) there and (0, 21, 21, 12) in the
+// PNG, on core 157 (measured 26.11.2026). So: a premultiplied copy to decide
+// and noise in, and WriteNoised to put the moved pixels into a copy of the
+// encoder's own.
+inline bool NoiseForEncoder(uint64_t seed,
+                            const SkPixmap& src,
+                            blink::Vector<uint8_t>& out) {
+  const SkColorType type = src.colorType();
+  if (!src.addr() || src.rowBytes() == 0 || src.width() <= 0 ||
+      src.height() <= 0 ||
+      (type != kBGRA_8888_SkColorType && type != kRGBA_8888_SkColorType)) {
+    return false;
+  }
+  const size_t row_bytes = src.rowBytes();
+  const size_t total = row_bytes * static_cast<size_t>(src.height());
+  const bool unpremul = src.alphaType() == kUnpremul_SkAlphaType;
+  const SkImageInfo premul =
+      unpremul ? src.info().makeAlphaType(kPremul_SkAlphaType) : src.info();
+  blink::Vector<uint8_t> original(static_cast<blink::wtf_size_t>(total));
+  SkPixmap original_pixmap(premul, original.data(), row_bytes);
+  if (!src.readPixels(original_pixmap)) {
+    return false;
+  }
+  blink::Vector<uint8_t> noised = original;
+  ApplyEdgeNoise(seed, base::span(original), base::span(noised), row_bytes, 0,
+                 0, src.width(), src.height(), 0, 0, src.width(), src.height(),
+                 src.width(), src.height(), type == kBGRA_8888_SkColorType);
+  out.resize(static_cast<blink::wtf_size_t>(total));
+  // SAFETY: `src` holds `total` bytes, rowBytes() apart for height() rows.
+  UNSAFE_BUFFERS(std::copy(static_cast<const uint8_t*>(src.addr()),
+                           static_cast<const uint8_t*>(src.addr()) + total,
+                           out.data()));
+  WriteNoised(base::span(original), base::span(noised), row_bytes, 0, 0,
+              src.width(), src.height(), out.data(), row_bytes, unpremul);
+  return true;
+}
