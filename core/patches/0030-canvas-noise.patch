+// Called by toDataURL() when the canvas wants noise — see
+// CanvasRenderingContextHost::FuryWantsCanvasNoise. It used to run inside
+// Create() for every caller, which also noised video snapshots and the
+// accessibility and inspector paths, and gave the canvas no say. toBlob() and
+// convertToBlob() noise their source pixels once in CanvasAsyncBlobCreator,
+// because their progressive encoder never passes through here.
+// getImageData() is perturbed separately but by the SAME function on the same
+// absolute coordinates, so all of them agree — a site that compares a pixel
+// from getImageData against the decoded PNG sees no contradiction.
+void ImageDataBuffer::ApplyFuryNoise() {
+  uint64_t seed = 0;
+  if (!fury::GetCanvasNoiseSeed(&seed)) {
+    return;
+  }
+  if (!is_valid_ || pixmap_.rowBytes() == 0 || pixmap_.height() <= 0) {
+    return;
+  }
+
+  const size_t total = pixmap_.rowBytes() * static_cast<size_t>(pixmap_.height());
+  fury_noised_pixels_.resize(static_cast<wtf_size_t>(total));
+  // SAFETY: pixmap_ is valid and describes exactly `total` bytes.
+  UNSAFE_BUFFERS(memcpy(fury_noised_pixels_.data(), pixmap_.addr(), total));
+
+  // Not RGBA here: this pixmap is the canvas's own backing store, which is N32
+  // — BGRA8888 on macOS and Windows. Asking it rather than assuming is what
+  // keeps the encoded PNG agreeing with getImageData.
+  // Premultiplied here, as the canvas's backing store is; see fury_flat.h for
+  // what is noised and why. pixmap_ still points at the original.
+  fury_flat::ApplyEdgeNoise(
+      seed,
+      // SAFETY: pixmap_ describes exactly `total` bytes.
+      UNSAFE_BUFFERS(base::span(static_cast<const uint8_t*>(pixmap_.addr()),
+                                total)),
+      base::span(fury_noised_pixels_), pixmap_.rowBytes(), 0, 0,
+      pixmap_.width(), pixmap_.height(), 0, 0, pixmap_.width(),
+      pixmap_.height(), pixmap_.width(), pixmap_.height(),
+      pixmap_.colorType() == kBGRA_8888_SkColorType);
+
+  pixmap_.reset(pixmap_.info(), fury_noised_pixels_.data(),
+                pixmap_.rowBytes());
+}
