+// Optional, measured values for the profile's exit. Invalid or missing fields
+// retain Chromium's own estimates; zero and false are valid overrides.
+std::optional<WebEffectiveConnectionType> FuryEffectiveType() {
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<std::string> value =
+            config->GetString("netinfo.effectiveType")) {
+      if (*value == "slow-2g")
+        return WebEffectiveConnectionType::kTypeSlow2G;
+      if (*value == "2g")
+        return WebEffectiveConnectionType::kType2G;
+      if (*value == "3g")
+        return WebEffectiveConnectionType::kType3G;
+      if (*value == "4g")
+        return WebEffectiveConnectionType::kType4G;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<uint32_t> FuryRtt() {
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<int> value = config->GetInt("netinfo.rtt")) {
+      if (*value >= 0 && *value <= 3000 && *value % 50 == 0)
+        return static_cast<uint32_t>(*value);
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<double> FuryDownlink() {
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<double> value = config->GetDouble("netinfo.downlink")) {
+      if (*value >= 0 && *value <= 10 &&
+          std::abs(*value * 20 - std::round(*value * 20)) < 1e-6)
+        return *value;
+    }
+  }
+  return std::nullopt;
+}
