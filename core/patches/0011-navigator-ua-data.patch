+namespace {
+
+// Applies the configured Client Hints on top of the real ones.
+//
+// Called from every return path of GetUserAgentMetadata() on purpose. A page
+// that receives only the low-entropy hints must see the same brands as one
+// that calls getHighEntropyValues(), and a mismatch between those two is
+// exactly the kind of self-contradiction detectors look for.
+//
+// Brand lists are all-or-nothing: a half-replaced list would mix a spoofed
+// Chrome version with the real one.
+void ApplyFuryMetadataOverrides(blink::UserAgentMetadata& metadata) {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return;
+  }
+
+  auto set_string = [&](std::string_view path, std::string& target) {
+    if (std::optional<std::string> v = config->GetString(path)) {
+      target = *v;
+    }
+  };
+
+  set_string("clientHints.platform", metadata.platform);
+  set_string("clientHints.platformVersion", metadata.platform_version);
+  set_string("clientHints.architecture", metadata.architecture);
+  set_string("clientHints.bitness", metadata.bitness);
+  set_string("clientHints.fullVersion", metadata.full_version);
+  // Empty is a legitimate value for model on desktop, so it is set
+  // unconditionally rather than guarded on non-emptiness.
+  set_string("clientHints.model", metadata.model);
+
+  if (std::optional<bool> mobile = config->GetBool("clientHints.mobile")) {
+    metadata.mobile = *mobile;
+  }
+  if (std::optional<bool> wow64 = config->GetBool("clientHints.wow64")) {
+    metadata.wow64 = *wow64;
+  }
+
+  if (std::optional<std::vector<std::string>> form_factors =
+          config->GetStringList("clientHints.formFactors")) {
+    metadata.form_factors = *form_factors;
+  }
+
+  // Brands arrive as a flat list of "Brand/Version" pairs — flat because the
+  // config schema stays JSON-simple and the ordering, including the GREASE
+  // entry, is part of the fingerprint and must be preserved verbatim.
+  auto parse_brands = [&](std::string_view path,
+                          blink::UserAgentBrandList& target) {
+    std::optional<std::vector<std::string>> raw = config->GetStringList(path);
+    if (!raw) {
+      return;
+    }
+    blink::UserAgentBrandList parsed;
+    parsed.reserve(raw->size());
+    for (const std::string& entry : *raw) {
+      size_t slash = entry.rfind('/');
+      if (slash == std::string::npos || slash == 0 ||
+          slash + 1 == entry.size()) {
+        // Refuse the whole list rather than emit a partial one.
+        LOG(ERROR) << "fury: malformed brand entry \"" << entry << "\" at "
+                   << path;
+        return;
+      }
+      parsed.emplace_back(entry.substr(0, slash), entry.substr(slash + 1));
+    }
+    target = std::move(parsed);
+  };
+
+  parse_brands("clientHints.brands", metadata.brand_version_list);
+  parse_brands("clientHints.fullVersionList",
+               metadata.brand_full_version_list);
+}
