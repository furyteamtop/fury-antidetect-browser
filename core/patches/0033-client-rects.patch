@@ -3464,6 +3466,20 @@ Vector<gfx::RectF> Element::GetClientRectsNoAdjustment() {
   for (auto& quad : quads) {
     result.emplace_back(quad.BoundingBox());
   }
+
+  // getClientRects() and getBoundingClientRect() both read through here, so one
+  // override keeps them agreeing. Sub-pixel and derived from the value itself,
+  // so the same element measured twice gives the same answer — a detector that
+  // loops over getBoundingClientRect() must not see geometry drift.
+  uint64_t seed = 0;
+  if (fury::GetClientRectsNoiseSeed(&seed)) {
+    for (auto& rect : result) {
+      rect.SetRect(fury::PerturbRectValue(seed, rect.x()),
+                   fury::PerturbRectValue(seed, rect.y()),
+                   fury::PerturbRectValue(seed, rect.width()),
+                   fury::PerturbRectValue(seed, rect.height()));
+    }
+  }
   return result;
 }
 
