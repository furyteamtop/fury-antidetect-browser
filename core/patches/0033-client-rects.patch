+  // Same perturbation as getClientRects above: this path does not go through
+  // GetClientRectsNoAdjustment, and leaving it unperturbed would let a page
+  // compare the two and see one lying.
+  uint64_t fury_seed = 0;
+  if (fury::GetClientRectsNoiseSeed(&fury_seed)) {
+    result.SetRect(fury::PerturbRectValue(fury_seed, result.x()),
