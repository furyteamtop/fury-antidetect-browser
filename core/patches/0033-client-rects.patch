+// Fury (0033): the edges Element::getBoundingClientRect() reports, moved the
+// same way, so a Range over a span's text and the span itself still measure
+// alike. Transformed quads are left as layout produced them, as the element
+// side leaves values off the layout grid.
+static void FuryPerturbQuads(Vector<gfx::QuadF>& quads,
+                             const LayoutObject& layout_object) {
+  uint64_t seed = 0;
+  if (!fury::GetClientRectsNoiseSeed(&seed)) {
+    return;
+  }
+  const double zoom = layout_object.Style().EffectiveZoom();
+  for (auto& quad : quads) {
+    if (!quad.IsRectilinear()) {
+      continue;
+    }
+    const gfx::RectF box = quad.BoundingBox();
+    const double left = fury::PerturbLayoutEdge(seed, box.x(), zoom);
+    const double top = fury::PerturbLayoutEdge(seed, box.y(), zoom);
+    const double right = fury::PerturbLayoutEdge(seed, box.right(), zoom);
+    const double bottom = fury::PerturbLayoutEdge(seed, box.bottom(), zoom);
+    if (right < left || bottom < top) {
+      continue;
+    }
+    quad = gfx::QuadF(gfx::RectF(left, top, right - left, bottom - top));
+  }
+}
