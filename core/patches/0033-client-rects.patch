+// Fury (0033): a client rect with its edges moved by fury::PerturbLayoutEdge,
+// before the zoom adjustment, while its numbers are still layout units.
+static gfx::RectF FuryPerturbClientRect(uint64_t seed,
+                                        const gfx::RectF& rect,
+                                        const LayoutObject* layout_object) {
+  const double zoom =
+      layout_object ? layout_object->Style().EffectiveZoom() : 1.0;
+  const double left = fury::PerturbLayoutEdge(seed, rect.x(), zoom);
+  const double top = fury::PerturbLayoutEdge(seed, rect.y(), zoom);
+  const double right = fury::PerturbLayoutEdge(seed, rect.right(), zoom);
+  const double bottom = fury::PerturbLayoutEdge(seed, rect.bottom(), zoom);
+  if (right < left || bottom < top) {
+    return rect;
+  }
+  return gfx::RectF(left, top, right - left, bottom - top);
+}
