 namespace {
 
+// Fury patch 0905: the profile's name at the leading edge of the tab strip,
+// beside the window controls.
+//
+// Every profile is the same core with the same icon, so five windows of one
+// site (five Ads Managers, measured by a tester on 21.11.2026) could be told
+// apart by nothing on screen. The name is the operator's, from the app
+// (window.profileName, the same key patch 0904 puts in the title); it is
+// browser UI, which no page can read.
+//
+// It is laid out like the leading buttons beside it: ignored by the flex
+// layout and placed by hand, to the left of them, with its width added to the
+// tab strip's leading margin. Found by id rather than kept in a member, so the
+// class header, which half the browser includes, stays untouched.
+constexpr int kFuryProfileBadgeId = 0x46555259;  // "FURY"
+constexpr int kFuryProfileBadgeMaxWidth = 180;
+
+void MaybeAddFuryProfileBadge(views::View* region,
+                              BrowserWindowInterface* browser) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return;
+  }
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config) {
+    return;
+  }
+  const std::optional<std::string> name =
+      config->GetString("window.profileName");
+  if (!name || name->empty()) {
+    return;
+  }
+  auto badge = std::make_unique<views::Label>(base::UTF8ToUTF16(*name));
+  badge->SetID(kFuryProfileBadgeId);
+  badge->SetElideBehavior(gfx::ELIDE_TAIL);
+  badge->SetMaximumWidthSingleLine(kFuryProfileBadgeMaxWidth);
+  badge->SetEnabledColor(kColorTabForegroundActiveFrameActive);
+  badge->SetBackground(views::CreateRoundedRectBackground(
+      kColorTabBackgroundActiveFrameActive, 6));
+  badge->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(3, 8)));
+  // On a layer of its own, as the leading buttons are: the tab strip paints to
+  // a layer that spans this space, and a badge painted into the region's own
+  // canvas was laid out, took its room, and never showed (22.11.2026).
+  badge->SetPaintToLayer();
+  badge->layer()->SetFillsBoundsOpaquely(false);
+  // Clicks and drags fall through to the strip, as on its empty space.
+  badge->SetCanProcessEventsWithinSubtree(false);
+  badge->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  region->AddChildView(std::move(badge));
+}
+
+const views::View* FuryProfileBadge(const views::View* region) {
+  const views::View* badge = region->GetViewByID(kFuryProfileBadgeId);
+  return badge && badge->GetVisible() ? badge : nullptr;
+}
+
+// Whether UpdateTabStripMargin counts the combo button as a leading button:
+// the same test it makes, so the badge lands beside it and not under it.
+bool FuryComboButtonCounted(TabStripComboButton* combo) {
+  return combo && ((combo->start_button() && combo->start_button()->GetVisible()) ||
+                   (combo->end_button() && combo->end_button()->GetVisible()));
+}
+
+// The room the badge takes, padding included, or 0 without one.
+int FuryProfileBadgeWidth(const views::View* region) {
+  const views::View* badge = FuryProfileBadge(region);
+  return badge ? badge->GetPreferredSize().width() +
+                     GetLayoutConstant(LayoutConstant::kTabStripPadding)
+               : 0;
+}
+
+// Left of everything else before the tab strip: `offset` is the width the
+// leading buttons already take, measured from the strip as they are.
+void PlaceFuryProfileBadge(views::View* region,
+                           const views::View* tab_strip,
+                           int offset) {
+  views::View* badge = region->GetViewByID(kFuryProfileBadgeId);
+  if (!badge || !badge->GetVisible() || !tab_strip) {
+    return;
+  }
+  const gfx::Size size = badge->GetPreferredSize();
+  const int x = tab_strip->x() + TabStyle::Get()->GetBottomCornerRadius() -
+                GetLayoutConstant(LayoutConstant::kTabStripPadding) -
+                size.width() - offset;
+  const int y = std::max(0, (region->height() - size.height()) / 2);
+  badge->SetBoundsRect(gfx::Rect(gfx::Point(x, y), size));
+}
