 bool Navigator::webdriver() const {
+  // Keeps navigator.webdriver false even while the profile is being driven over
+  // CDP.
+  //
+  // This is what makes the local automation API usable at all. Without it,
+  // attaching Puppeteer to a profile flips this to true and every page can see
+  // it — so the operator has to choose between automating an account and
+  // keeping it. Real Chrome reports exactly `false` here, and that is what a
+  // profile must keep reporting whether or not anyone is driving it.
+  //
+  // Off by default: an unconfigured build stays honest, and the detect-suite
+  // measures it against stock Chromium.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (config->GetBool("automation.hideTraces").value_or(false)) {
+      return false;
+    }
+  }
+
   if (RuntimeEnabledFeatures::AutomationControlledEnabled())
     return true;
 
