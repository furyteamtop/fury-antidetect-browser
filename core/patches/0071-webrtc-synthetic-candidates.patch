+namespace {
+
+// Fury (patch 0071). The candidates a stock Chrome gathers, with no socket
+// behind them.
+//
+// Under the IP-handling policy "disable_non_proxied_udp" (patch 0070, every
+// Fury profile) the allocator creates no UDP port, so a page gathers nothing:
+// iceGatheringState goes to "complete" with zero candidates. No leak, and not
+// what a browser looks like either. BrowserScan reads it as "WebRTC disabled",
+// who.1ms.dog as "UDP blocked" (issue 31, measured on 0.5.1). A stock Chrome
+// 157 on the same Mac, measured 13.11.2026, gathers
+//
+//   <uuid>.local 53339 typ host                        priority 2113937151
+//   <public ip> 6208 typ srflx raddr 0.0.0.0 rport 0   priority 1677729535
+//
+// the second only when the page named a STUN server, and the SDP's c= line
+// then carries the public address.
+//
+// This port announces that shape: the host candidate under the mDNS name the
+// agent chose for this launch, and the srflx candidate under the proxy's exit
+// address, which is what a STUN server would have seen had the traffic gone
+// through the proxy. Priorities, foundation and network cost come out of the
+// same code a UDPPort uses, from a stand-in private address that is replaced by
+// the name before the candidate leaves the port.
+//
+// It owns no socket, so nothing it announces can be reached and nothing goes
+// out: no STUN request, no DNS lookup of the STUN server's name, no
+// connectivity check. CreateConnection refuses, so a remote peer pairs with
+// nothing -- as with a stock Chrome behind a firewall that drops UDP. The cost
+// is that a page which actually connects two peers (its own loopback pair, a
+// call) still fails where Chrome succeeds, which it already did.
+//
+// The STUN server is not contacted, so its existence cannot be confirmed. A
+// server that obviously cannot answer -- an IP literal on a loopback, private
+// or link-local address -- gets no srflx, as it would get none in Chrome; a
+// hostname is taken on trust, because resolving it from here would be a DNS
+// query outside the proxy.
+class FurySyntheticPort : public Port {
+ public:
+  FurySyntheticPort(const PortParametersRef& args,
+                    std::string hostname,
+                    const IPAddress& public_ip,
+                    std::optional<SocketAddress> stun_server)
+      : Port(args, IceCandidateType::kHost),
+        hostname_(std::move(hostname)),
+        public_ip_(public_ip),
+        stun_server_(std::move(stun_server)) {}
+
+  void PrepareAddress() override {
+    // An ephemeral port as macOS and Windows hand them out, and a mapped
+    // port anywhere a NAT might put it.
+    const uint16_t host_port = 49152 + CreateRandomId() % 16384;
+    const uint16_t mapped_port = 1024 + CreateRandomId() % 64512;
+    // Feeds the foundation and the address precedence of the priority, then
+    // is replaced by the name. Never signalled.
+    const SocketAddress base(
+        IPAddress((192u << 24) | (168u << 16) | ((CreateRandomId() % 256) << 8) |
+                  (2 + CreateRandomId() % 252)),
+        host_port);
+
+    Candidate host = Make(base, base, IceCandidateType::kHost,
+                          ICE_TYPE_PREFERENCE_HOST, "");
+    host.set_address(SocketAddress(hostname_, host_port));
+    Emit(host, /*is_final=*/!stun_server_.has_value());
+    if (!stun_server_) {
+      return;
+    }
+
+    StringBuilder url;
+    url << "stun:" << stun_server_->hostname() << ":" << stun_server_->port();
+    Candidate srflx = Make(SocketAddress(public_ip_, mapped_port), base,
+                           IceCandidateType::kSrflx, ICE_TYPE_PREFERENCE_SRFLX,
+                           url.str());
+    // 0.0.0.0 0, as Chrome shows it. Not left to SanitizeCandidate: under
+    // this policy's flags it clears a srflx raddr only with mDNS on, which an
+    // any-address network does not have, and the stand-in address leaked
+    // (verify-0071, 13.11.2026).
+    srflx.set_related_address(EmptySocketAddressWithFamily(AF_INET));
+    // A STUN round trip takes time; an answer in zero milliseconds is a
+    // measurement of its own.
+    thread()->PostDelayedTask(
+        SafeTask(safety_.flag(),
+                 [this, srflx] { Emit(srflx, /*is_final=*/true); }),
+        TimeDelta::Millis(25 + CreateRandomId() % 70));
+  }
+
+  Connection* CreateConnection(const Candidate& /* remote */,
+                               CandidateOrigin /* origin */) override {
+    return nullptr;
+  }
+  int SendTo(std::span<const uint8_t> /* data */,
+             const SocketAddress& /* addr */,
+             const AsyncSocketPacketOptions& /* options */,
+             bool /* payload */) override {
+    return -1;
+  }
+  int SetOption(Socket::Option /* opt */, int /* value */) override {
+    return 0;
+  }
+  int GetOption(Socket::Option /* opt */, int* /* value */) override {
+    return -1;
+  }
+  int GetError() override { return 0; }
+  bool SupportsProtocol(absl::string_view protocol) const override {
+    return protocol == UDP_PROTOCOL_NAME;
+  }
+  ProtocolType GetProtocol() const override { return PROTO_UDP; }
+  void OnSentPacket(AsyncPacketSocket* /* socket */,
+                    const SentPacketInfo& /* sent_packet */) override {}
+
+ private:
+  // Port::AddAddress would write the stand-in address into the SDP: the
+  // serializer prints an address's IP whenever it has one, and only an mDNS
+  // responder -- which an any-address network does not have -- strips it. So
+  // the candidate is finished here instead, with the name alone.
+  //
+  // FinishAddingAddress runs on the port's thread, and both callers are on
+  // it: PrepareAddress is called there by the session, and the srflx task is
+  // posted to thread(). The analysis cannot see that, because the thread it
+  // names is a private member of Port.
+  void Emit(const Candidate& c, bool is_final) RTC_NO_THREAD_SAFETY_ANALYSIS {
+    RTC_DCHECK(thread()->IsCurrent());
+    FinishAddingAddress(c, is_final);
+  }
+
+  // What Port::AddAddress builds, without its mDNS step: the name is already
+  // chosen, and an any-address network has no responder to ask.
+  Candidate Make(const SocketAddress& address,
+                 const SocketAddress& base,
+                 IceCandidateType type,
+                 uint32_t type_preference,
+                 absl::string_view url) {
+    Candidate c(component(), UDP_PROTOCOL_NAME, address, 0U,
+                username_fragment(), password(), type, generation(), "",
+                Network()->id(), network_cost());
+    c.ComputeFoundation(base, IceTiebreaker());
+    c.set_priority(c.GetPriority(
+        type_preference, Network()->preference(), 0,
+        env().field_trials().IsEnabled(
+            "WebRTC-IncreaseIceCandidatePriorityHostSrflx")));
+    c.set_network_name(Network()->name());
+    c.set_network_type(Network()->type());
+    c.set_underlying_type_for_vpn(Network()->underlying_type_for_vpn());
+    c.set_url(url);
+    c.set_network_slice(Network()->network_slice());
+    return c;
+  }
+
+  const std::string hostname_;
+  const IPAddress public_ip_;
+  const std::optional<SocketAddress> stun_server_;
+  ScopedTaskSafety safety_;
+};
+
+// The STUN server a srflx candidate may claim to have come from, or none.
+std::optional<SocketAddress> FuryStunServer(const ServerAddresses& servers) {
+  for (const SocketAddress& server : servers) {
+    if (!server.IsUnresolvedIP()) {
+      const IPAddress& ip = server.ipaddr();
+      if (IPIsAny(ip) || IPIsPrivate(ip) || IPIsUnspec(ip)) {
+        continue;
+      }
+    }
+    return server;
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
 void AllocationSequence::CreateUDPPorts() {
   if (IsFlagSet(PORTALLOCATOR_DISABLE_UDP)) {
+    // Fury (patch 0071): one synthetic port on the IPv4 any-address network,
+    // when the profile knows its exit address. See FurySyntheticPort.
+    const auto& synthetic =
+        session_->allocator()->fury_synthetic_candidates();
+    if (synthetic && network_->GetBestIP().family() == AF_INET) {
+      // PORTALLOCATOR_DISABLE_STUN comes with DISABLE_UDP from the same
+      // policy and is not consulted: nothing here contacts the server.
+      std::optional<SocketAddress> stun_server;
+      if (config_) {
+        stun_server = FuryStunServer(config_->StunServers());
+      }
+      session_->AddAllocatedPort(
+          new FurySyntheticPort(
+              {.env = session_->allocator()->env(),
+               .network_thread = session_->network_thread(),
+               .socket_factory = session_->socket_factory(),
+               .network = network_,
+               .ice_username_fragment = session_->username(),
+               .ice_password = session_->password(),
+               .content_name = session_->content_name(),
+               .lna_permission_factory =
+                   session_->allocator()->lna_permission_factory(),
+               .ice_tiebreaker = session_->allocator()->ice_tiebreaker()},
+              synthetic->hostname, synthetic->public_ip, stun_server),
+          this);
+      return;
+    }
     RTC_LOG(LS_VERBOSE) << "AllocationSequence: UDP ports disabled, skipping.";
     return;
   }
