+std::unique_ptr<device::LocationProvider>
+ChromeContentBrowserClient::OverrideSystemLocationProvider() {
+  // Nothing above this line changes. The provider slots in where CoreLocation
+  // and the network provider slot in — downstream of the permission gate, so a
+  // page that was never allowed still gets nothing, and upstream of the caching
+  // and delivery, so watchPosition and a denial behave exactly as Chromium
+  // makes them behave.
+  return fury::FuryLocationProvider::MaybeCreate();
+}
+
 std::string ChromeContentBrowserClient::GetGeolocationApiKey() {
 #if BUILDFLAG(IS_CHROMEOS)
   if (ash::features::IsCrosSeparateGeoApiKeyEnabled()) {
@@ -3954,6 +3965,35 @@ std::string ChromeContentBrowserClient::GetGeolocationApiKey() {
 #if BUILDFLAG(OS_LEVEL_GEOLOCATION_PERMISSION_SUPPORTED)
 device::GeolocationSystemPermissionManager*
 ChromeContentBrowserClient::GetGeolocationSystemPermissionManager() {
+  // Part of patch 0082, and the part without which the rest of it does nothing.
+  //
+  // On macOS and Windows the operating system has its own opinion about whether
+  // this application may read location, and Chromium asks it FIRST — before any
+  // provider is consulted at all. GeolocationProviderImpl::OnClientsChanged
+  // returns early while the system status is anything but kAllowed
+  // (geolocation_provider_impl.cc:297-300), so on a Mac that has never granted
+  // Fury access to Location Services, every getCurrentPosition times out and
+  // the custom provider is never asked for anything. Measured exactly that:
+  // position "Timeout expired" with a perfectly good position sitting in the
+  // config.
+  //
+  // Returning nullptr here makes the constructor take its other branch and set
+  // the status to kAllowed (geolocation_provider_impl.cc:238-243). That is not
+  // a lie told to the OS — it is declining to ask a question whose answer is
+  // irrelevant, because with a persona position configured no OS sensor is ever
+  // touched. It also means no location indicator appears in the menu bar, which
+  // is right: nothing is using the machine's location.
+  //
+  // Only when a position is actually configured, and gated on the same
+  // predicate the provider itself uses. The two must agree: on Apple,
+  // LocationProviderManager::NewSystemLocationProvider CHECKs this manager is
+  // present (location_provider_manager.cc:385), and it is only unreachable
+  // because a custom provider forces kCustomOnly. Suppress the manager without
+  // supplying a provider and the browser crashes the first time a page asks
+  // where it is.
+  if (fury::FuryLocationProvider::ConfiguredFix()) {
+    return nullptr;
+  }
   return device::GeolocationSystemPermissionManager::GetInstance();
 }
 #endif
