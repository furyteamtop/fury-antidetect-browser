@@ -0,0 +1,24 @@
+# Copyright 2026 The Fury Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/config/features.gni")
+
+# A component rather than a source_set: this is linked from both //content and
+# //third_party/blink, and a static library duplicated into two link units
+# would give each its own copy of the process-global config — which is exactly
+# the inconsistency this whole patch exists to prevent.
+component("fury") {
+  output_name = "fury"
+
+  sources = [
+    "fury_config.cc",
+    "fury_config.h",
+    "fury_switches.cc",
+    "fury_switches.h",
+  ]
+
+  defines = [ "IS_FURY_IMPL" ]
+
+  deps = [ "//base" ]
+}
diff --git a/components/fury/fury_config.cc b/components/fury/fury_config.cc
new file mode 100644
index 0000000000..1517cbc7a5
--- /dev/null
+++ b/components/fury/fury_config.cc
@@ -0,0 +1,237 @@
+// Copyright 2026 The Fury Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/fury/fury_config.h"
+
+#include <string>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/memory/shared_memory_switch.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/values.h"
+
+namespace fury {
+
+// Holds the parsed config. Lives entirely in this translation unit so that
+// consumers in Blink and //content never see base::Value.
+//
+// Note the M150 spelling: base::DictValue / base::ListValue, not the older
+// base::Value::Dict / base::Value::List. Worth pinning down at rebase time —
+// this is exactly the kind of rename that makes a patch apply cleanly and then
+// fail to compile.
+class FuryConfig::Storage {
+ public:
+  explicit Storage(base::DictValue dict) : dict_(std::move(dict)) {}
+
+  const base::Value* Find(std::string_view path) const {
+    return dict_.FindByDottedPath(path);
+  }
+
+ private:
+  const base::DictValue dict_;
+};
+
+namespace {
+
+// Owned for the process lifetime and never destroyed: worker threads may still
+// be reading it during shutdown, and tearing it down under them buys nothing.
+FuryConfig* g_config = nullptr;
+
+base::ReadOnlySharedMemoryRegion& GetRegionStorage() {
+  static base::NoDestructor<base::ReadOnlySharedMemoryRegion> region;
+  return *region;
+}
+
+// A config that does not fit in this is not a config, it is an accident.
+constexpr size_t kMaxConfigBytes = 4 * 1024 * 1024;
+
+std::optional<std::string> ReadAllFromFd(int fd) {
+  std::string out;
+  char buf[4096];
+  while (true) {
+    ssize_t n = HANDLE_EINTR(read(fd, buf, sizeof(buf)));
+    if (n < 0) {
+      PLOG(ERROR) << "fury: reading fingerprint config";
+      return std::nullopt;
+    }
+    if (n == 0) {
+      break;
+    }
+    if (out.size() + static_cast<size_t>(n) > kMaxConfigBytes) {
+      LOG(ERROR) << "fury: fingerprint config exceeds " << kMaxConfigBytes
+                 << " bytes";
+      return std::nullopt;
+    }
+    out.append(buf, static_cast<size_t>(n));
+  }
+  return out;
+}
+
+}  // namespace
+
+FuryConfig::FuryConfig() = default;
+FuryConfig::~FuryConfig() = default;
+
+// static
+const FuryConfig* FuryConfig::Get() {
+  return g_config;
+}
+
+// static
+const base::ReadOnlySharedMemoryRegion& FuryConfig::GetRegionForChildren() {
+  return GetRegionStorage();
+}
+
+// static
+bool FuryConfig::InitializeFromJson(std::string_view json) {
+  if (g_config) {
+    // Initialising twice would mean one process gave two different answers at
+    // two different times. Refuse loudly rather than pick one.
+    LOG(ERROR) << "fury: config already initialised";
+    return false;
+  }
+
+  // Strict RFC parsing: no trailing commas, no comments. The producer is our
+  // own agent, so anything sloppy is a bug worth failing on rather than
+  // tolerating.
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    LOG(ERROR) << "fury: fingerprint config is not a JSON object";
+    return false;
+  }
+
+  base::DictValue dict = std::move(*parsed);
+
+  std::optional<int> schema = dict.FindInt("schema_version");
+  if (!schema.has_value()) {
+    LOG(ERROR) << "fury: fingerprint config has no schema_version";
+    return false;
+  }
+  if (*schema != kSupportedSchemaVersion) {
+    // Deliberately fatal rather than best-effort: honouring some fields and
+    // ignoring others produces a profile whose spoofed values contradict its
+    // un-spoofed ones, which is a stronger signal than not spoofing at all.
+    LOG(ERROR) << "fury: fingerprint config schema " << *schema
+               << " is not supported by this build (expected "
+               << kSupportedSchemaVersion << ")";
+    return false;
+  }
+
+  auto* config = new FuryConfig();
+  config->storage_ = std::make_unique<Storage>(std::move(dict));
+  g_config = config;
+  return true;
+}
+
+// static
+bool FuryConfig::InitializeInBrowser(int fd) {
+  std::optional<std::string> json = ReadAllFromFd(fd);
+  if (!json) {
+    return false;
+  }
+  if (!InitializeFromJson(*json)) {
+    return false;
+  }
+
+  // Publish for the children. Failing here is not fatal to the browser itself,
+  // but it is fatal to consistency: renderers would run unconfigured while the
+  // browser is configured. Drop the config entirely instead of going halfway.
+  base::MappedReadOnlyRegion mapped =
+      base::ReadOnlySharedMemoryRegion::Create(json->size());
+  if (!mapped.IsValid()) {
+    LOG(ERROR) << "fury: cannot allocate shared memory for the config";
+    delete g_config;
+    g_config = nullptr;
+    return false;
+  }
+  auto span = mapped.mapping.GetMemoryAsSpan<char>();
+  std::copy(json->begin(), json->end(), span.begin());
+  GetRegionStorage() = std::move(mapped.region);
+  return true;
+}
+
+// static
+bool FuryConfig::InitializeInChild(std::string_view switch_value) {
+  auto region =
+      base::shared_memory::ReadOnlySharedMemoryRegionFrom(switch_value);
+  if (!region.has_value()) {
+    LOG(ERROR) << "fury: cannot recover the config region from the switch";
+    return false;
+  }
+
+  base::ReadOnlySharedMemoryMapping mapping = region->Map();
+  if (!mapping.IsValid()) {
+    LOG(ERROR) << "fury: cannot map the config region";
+    return false;
+  }
+
+  auto bytes = mapping.GetMemoryAsSpan<const char>();
+  return InitializeFromJson(std::string_view(bytes.data(), bytes.size()));
+}
+
+std::optional<int> FuryConfig::GetInt(std::string_view path) const {
+  const base::Value* v = storage_->Find(path);
+  return v ? v->GetIfInt() : std::nullopt;
+}
+
+std::optional<double> FuryConfig::GetDouble(std::string_view path) const {
+  const base::Value* v = storage_->Find(path);
+  if (!v) {
+    return std::nullopt;
+  }
+  // JSON does not distinguish 8 from 8.0; accept either for a double field.
+  if (std::optional<double> d = v->GetIfDouble()) {
+    return d;
+  }
+  if (std::optional<int> i = v->GetIfInt()) {
+    return static_cast<double>(*i);
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> FuryConfig::GetString(std::string_view path) const {
+  const base::Value* v = storage_->Find(path);
+  if (!v) {
+    return std::nullopt;
+  }
+  const std::string* s = v->GetIfString();
+  return s ? std::optional<std::string>(*s) : std::nullopt;
+}
+
+std::optional<bool> FuryConfig::GetBool(std::string_view path) const {
+  const base::Value* v = storage_->Find(path);
+  return v ? v->GetIfBool() : std::nullopt;
+}
+
+std::optional<std::vector<std::string>> FuryConfig::GetStringList(
+    std::string_view path) const {
+  const base::Value* v = storage_->Find(path);
+  if (!v) {
+    return std::nullopt;
+  }
+  const base::ListValue* list = v->GetIfList();
+  if (!list) {
+    return std::nullopt;
+  }
+  std::vector<std::string> out;
+  out.reserve(list->size());
+  for (const base::Value& item : *list) {
+    const std::string* s = item.GetIfString();
+    if (!s) {
+      // A list with a non-string in it means the agent and the core disagree
+      // about the schema. Treat that as absent rather than silently dropping
+      // entries: a partially applied list is a contradiction.
+      LOG(ERROR) << "fury: non-string entry in list at " << path;
+      return std::nullopt;
+    }
+    out.push_back(*s);
+  }
+  return out;
+}
+
+}  // namespace fury
diff --git a/components/fury/fury_config.h b/components/fury/fury_config.h
new file mode 100644
index 0000000000..683a6c6f90
--- /dev/null
+++ b/components/fury/fury_config.h
@@ -0,0 +1,103 @@
+// Copyright 2026 The Fury Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_FURY_FURY_CONFIG_H_
+#define COMPONENTS_FURY_FURY_CONFIG_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/component_export.h"
+#include "base/memory/read_only_shared_memory_region.h"
+
+namespace fury {
+
+// The fingerprint configuration for this browser session.
+//
+// Design constraints, in order of importance:
+//
+//  1. **Every execution context must see the same value.** A product that
+//     spoofs the main frame and forgets `new Worker(...)` looks perfect on a
+//     naive checker and is caught by CreepJS in one line. The config therefore
+//     lives in a read-only shared memory region mapped into every child
+//     process, and is reachable from any thread inside it — main thread,
+//     worker threads, worklets alike.
+//
+//  2. **Immutable after startup.** Read once, never updated. A config that
+//     could change at runtime is a channel a page could probe for the
+//     existence of the spoofing machinery.
+//
+//  3. **Never in argv.** See fury_switches.h.
+//
+// The storage format is deliberately hidden behind a pimpl. Consumers live in
+// Blink, //content and eventually //net, and none of them should have to agree
+// on a JSON library or grow an include dependency on base::Value just to read
+// an integer. It also means the on-the-wire format can change without touching
+// a single call site.
+//
+// Thread safety: the instance is initialised exactly once, before any renderer
+// thread starts, and is const afterwards. Concurrent reads need no locking, and
+// there is deliberately no setter.
+class COMPONENT_EXPORT(FURY) FuryConfig {
+ public:
+  // The schema version this build understands. The core refuses to start on a
+  // config it cannot fully interpret rather than silently ignoring fields —
+  // partial spoofing is worse than none, because the un-spoofed values then
+  // contradict the spoofed ones.
+  static constexpr int kSupportedSchemaVersion = 1;
+
+  FuryConfig(const FuryConfig&) = delete;
+  FuryConfig& operator=(const FuryConfig&) = delete;
+  ~FuryConfig();
+
+  // Returns the active config, or nullptr when the browser was started without
+  // one. Callers must treat nullptr as "behave exactly like stock Chromium":
+  // an unconfigured build has to be indistinguishable from upstream, because
+  // that is what the detect-suite measures it against.
+  static const FuryConfig* Get();
+
+  // Browser process. Reads the JSON the agent wrote to `fd`, parses it, and
+  // publishes it into a read-only shared memory region for the children.
+  // Returns false and leaves the process unconfigured on any failure.
+  static bool InitializeInBrowser(int fd);
+
+  // Child processes. `switch_value` is the opaque handle produced by
+  // base::shared_memory::SharedMemorySwitch in the browser.
+  static bool InitializeInChild(std::string_view switch_value);
+
+  // The region to hand to child processes. Invalid when unconfigured.
+  static const base::ReadOnlySharedMemoryRegion& GetRegionForChildren();
+
+  // Typed lookups by dotted path, e.g. "navigator.hardwareConcurrency".
+  //
+  // std::nullopt means the key is absent, and every caller must render that as
+  // "use the real value" — never as a zero or an empty string, which would be
+  // a fingerprint of its own.
+  std::optional<int> GetInt(std::string_view path) const;
+  std::optional<double> GetDouble(std::string_view path) const;
+  std::optional<std::string> GetString(std::string_view path) const;
+  std::optional<bool> GetBool(std::string_view path) const;
+  // Absent and empty are distinct: an empty font list is a valid instruction,
+  // an absent one means "leave the real list alone".
+  std::optional<std::vector<std::string>> GetStringList(
+      std::string_view path) const;
+
+ private:
+  class Storage;
+
+  FuryConfig();
+
+  // Parses and validates `json`. Returns false if it is malformed or declares
+  // an unsupported schema version.
+  static bool InitializeFromJson(std::string_view json);
+
+  std::unique_ptr<Storage> storage_;
+};
+
+}  // namespace fury
+
+#endif  // COMPONENTS_FURY_FURY_CONFIG_H_
