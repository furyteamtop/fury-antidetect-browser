diff --git a/components/fury/fury_switches.h b/components/fury/fury_switches.h
new file mode 100644
index 0000000000..37816cfb05
--- /dev/null
+++ b/components/fury/fury_switches.h
@@ -0,0 +1,32 @@
+// Copyright 2026 The Fury Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_FURY_FURY_SWITCHES_H_
+#define COMPONENTS_FURY_FURY_SWITCHES_H_
+
+#include "base/component_export.h"
+
+namespace fury {
+namespace switches {
+
+// Browser process only. The number of an inherited file descriptor the agent
+// has written the fingerprint config JSON to.
+//
+// The config never travels in argv itself: process arguments are readable by
+// any other process on the machine (`ps`, Process Explorer, and any native
+// helper an anti-fraud vendor ships), and a command line containing a profile's
+// whole spoofed persona would hand it over for free. Only the descriptor number
+// appears here.
+COMPONENT_EXPORT(FURY) extern const char kFingerprintFd[];
+
+// Child processes. Carries an opaque serialized handle to the read-only shared
+// memory region holding the config — not the config. Populated by the browser
+// via base::shared_memory::SharedMemorySwitch, the same mechanism Chromium
+// already uses for field trials and histograms.
+COMPONENT_EXPORT(FURY) extern const char kFingerprintHandle[];
+
+}  // namespace switches
+}  // namespace fury
+
+#endif  // COMPONENTS_FURY_FURY_SWITCHES_H_
