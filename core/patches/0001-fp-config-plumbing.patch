+// Update the process launch parameters to transmit the Fury fingerprint config
+// to the child process.
+//
+// The switch carries only an opaque serialized handle; the config itself lives
+// in the read-only shared memory region. That distinction is the entire point:
+// process arguments are world-readable, and a command line containing a
+// profile's spoofed persona would disclose it to anything that can run `ps`.
+//
+// Does nothing when the browser was started without a config, leaving children
+// to behave exactly like stock Chromium.
+void PassFuryConfigSharedMemoryHandle(
+    base::CommandLine& command_line,
+    base::LaunchOptions* launch_options,
+    [[maybe_unused]] FileMappedForLaunch* files_to_register) {
+  const base::ReadOnlySharedMemoryRegion& region =
+      fury::FuryConfig::GetRegionForChildren();
+  if (!region.IsValid()) {
+    return;
+  }
+  base::shared_memory::SharedMemorySwitch shared_memory_switch(
+      fury::switches::kFingerprintHandle, 'fury', kFuryFingerprintDescriptor);
+  shared_memory_switch.AddToLaunchParameters(region, &command_line,
+                                             launch_options);
+  TransferSharedMemorySwitchDescriptor(shared_memory_switch, files_to_register);
+}
+
 void PassStartupTracingConfigSharedMemoryHandle(
     const base::ReadOnlySharedMemoryRegion* read_only_memory_region,
     base::CommandLine& command_line,
@@ -327,6 +355,8 @@ void ChildProcessLauncherHelper::LaunchOnLauncherThread() {
       *command_line(), options_ptr, files_to_register.get());
   PassFieldTrialSharedMemoryHandle(*command_line(), options_ptr,
                                    files_to_register.get());
+  PassFuryConfigSharedMemoryHandle(*command_line(), options_ptr,
+                                   files_to_register.get());
   PassStartupTracingConfigSharedMemoryHandle(
       tracing_config_memory_region_ ? &tracing_config_memory_region_->data
                                     : nullptr,
