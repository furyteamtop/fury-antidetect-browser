@@ -57,6 +57,8 @@
 #include "build/build_config.h"
 #include "components/discardable_memory/service/discardable_shared_memory_manager.h"
 #include "components/download/public/common/download_task_runner.h"
+#include "components/fury/fury_config.h"
+#include "components/fury/fury_switches.h"
 #include "components/power_monitor/make_power_monitor_device_source.h"
 #include "components/variations/net/variations_command_line.h"
 #include "components/variations/variations_ids_provider.h"
@@ -852,6 +854,12 @@ int ContentMainRunnerImpl::Initialize(ContentMainParams params) {
   g_fds->Set(kPseudonymizationSaltDescriptor,
              kPseudonymizationSaltDescriptor +
                  base::GlobalDescriptors::kBaseDescriptor);
+  // Only consulted on POSIX platforms that are not Apple; macOS recovers the
+  // region through Mach port rendezvous instead. Registered unconditionally so
+  // the Linux build needs no separate patch.
+  g_fds->Set(kFuryFingerprintDescriptor,
+             kFuryFingerprintDescriptor +
+                 base::GlobalDescriptors::kBaseDescriptor);
 #endif  // !BUILDFLAG(IS_ANDROID)
 
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_OPENBSD)
@@ -862,6 +870,38 @@ int ContentMainRunnerImpl::Initialize(ContentMainParams params) {
 
 #endif  // !BUILDFLAG(IS_WIN)
 
+  // Load the Fury fingerprint config before anything can observe a value it is
+  // meant to override, and before the first child process is launched — the
+  // browser must already hold the shared memory region by then.
+  //
+  // Two distinct paths on purpose. The browser reads JSON from a descriptor the
+  // agent inherited to it; children recover a read-only mapping from an opaque
+  // handle. Neither ever carries the config in argv.
+  if (process_type.empty()) {
+    if (command_line.HasSwitch(fury::switches::kFingerprintFd)) {
+      int fd = -1;
+      if (base::StringToInt(
+              command_line.GetSwitchValueASCII(fury::switches::kFingerprintFd),
+              &fd) &&
+          fd >= 0) {
+        if (!fury::FuryConfig::InitializeInBrowser(fd)) {
+          // Refuse to run half-configured. A browser that believes it is
+          // spoofing while its renderers are not produces contexts that
+          // contradict each other, which is worse than no spoofing at all.
+          LOG(FATAL) << "fury: fingerprint config could not be loaded";
+        }
+      } else {
+        LOG(FATAL) << "fury: --" << fury::switches::kFingerprintFd
+                   << " is not a valid descriptor";
+      }
+    }
+  } else if (command_line.HasSwitch(fury::switches::kFingerprintHandle)) {
+    if (!fury::FuryConfig::InitializeInChild(command_line.GetSwitchValueASCII(
+            fury::switches::kFingerprintHandle))) {
+      LOG(FATAL) << "fury: child could not map the fingerprint config";
+    }
+  }
+
   is_initialized_ = true;
   TRACE_EVENT0("startup,benchmark,rail", "ContentMainRunnerImpl::Initialize");
 
