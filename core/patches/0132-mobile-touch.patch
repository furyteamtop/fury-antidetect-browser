+namespace {
+
+// SplitMix64, the derivation shared-rs uses for every per-profile stream: the
+// same seed is the same finger on every launch.
+uint64_t FurySplitMix(uint64_t& state) {
+  uint64_t z = (state += 0x9e3779b97f4a7c15ull);
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+  return z ^ (z >> 31);
+}
+
+double FuryUnit(uint64_t& state) {
+  return static_cast<double>(FurySplitMix(state) >> 11) * (1.0 / 9007199254740992.0);
+}
+
+// One standard normal draw, for the scatter of a single touch. Not seeded:
+// two taps on the same button by the same person do not land on the same
+// pixel.
+double FuryGaussian() {
+  const double u1 = std::max(base::RandDouble(), 1e-12);
+  const double u2 = base::RandDouble();
+  return std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * std::numbers::pi * u2);
+}
+
+}  // namespace
+
+// Patch 0132: the finger's habits on a phone persona, from mobile.touchSeed.
+//
+// A mouse turned into a touch lands on the cursor's pixel every time, with
+// the cursor image's radius on every contact and a force of exactly 1: a
+// finger does none of that. Per profile, stable across launches: a bias of
+// where the finger lands relative to what it aims at (a thumb lands a little
+// low, -2..2 px across and 0.5..3 px down), a typical contact radius (9..14
+// px) and a typical pressure (0.25..0.65). Per touch: scatter around that
+// (sigma 1.5 px, at most 4), the contact's size, its ellipse and angle, and
+// the pressure, held for the touch's life with a little drift while it moves.
+//
+// Taps stay on small targets: Blink adjusts a tap with a contact area to the
+// nearest clickable node (touch adjustment), as it does on Android.
+void TouchEmulatorImpl::FuryInitFinger() {
+  fury_finger_ready_ = true;
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || !config->GetBool("mobile.enabled").value_or(false)) {
+    return;
+  }
+  fury_finger_ = true;
+  uint64_t state =
+      static_cast<uint64_t>(config->GetInt("mobile.touchSeed").value_or(0)) ^
+      0x7f4a7c15f00dfeedull;
+  fury_bias_ = gfx::Vector2dF(static_cast<float>((FuryUnit(state) - 0.5) * 4.0),
+                              static_cast<float>(0.5 + FuryUnit(state) * 2.5));
+  fury_radius_base_ = static_cast<float>(9.0 + FuryUnit(state) * 5.0);
+  fury_force_base_ = static_cast<float>(0.25 + FuryUnit(state) * 0.4);
+}
+
+void TouchEmulatorImpl::FuryNewContact() {
+  auto scatter = [] {
+    return static_cast<float>(std::clamp(FuryGaussian() * 1.5, -4.0, 4.0));
+  };
+  fury_jitter_ = gfx::Vector2dF(scatter(), scatter());
+  fury_radius_x_ =
+      fury_radius_base_ * static_cast<float>(0.85 + base::RandDouble() * 0.3);
+  fury_radius_y_ =
+      fury_radius_x_ * static_cast<float>(0.85 + base::RandDouble() * 0.3);
+  fury_force_ = std::clamp(
+      fury_force_base_ + static_cast<float>((base::RandDouble() - 0.5) * 0.16),
+      0.05f, 1.f);
+  fury_rotation_ = static_cast<float>(base::RandDouble() * 90.0);
+}
