+// Patch 0132: one step of the wheel's finger. See HandleMouseWheelEvent.
+void TouchEmulatorImpl::FuryWheelFinger(const WebMouseWheelEvent& event) {
+  constexpr float kLiftAfter = 250.f;
+  auto press = [&](WebInputEvent::Type type, const gfx::PointF& at) {
+    WebMouseEvent m(type,
+                    type == WebInputEvent::Type::kMouseUp
+                        ? 0
+                        : WebInputEvent::kLeftButtonDown,
+                    base::TimeTicks::Now());
+    m.button = WebMouseEvent::Button::kLeft;
+    m.click_count = type == WebInputEvent::Type::kMouseMove ? 0 : 1;
+    m.SetPositionInWidget(at);
+    m.SetPositionInScreen(at);
+    // Not dropped as "too soon after the last move": every wheel step must
+    // move the finger.
+    last_mouse_event_was_move_ = false;
+    HandleMouseEvent(m, fury_wheel_view_.get());
+  };
+  if (!fury_wheel_down_) {
+    fury_wheel_origin_ = event.PositionInWidget();
+    fury_wheel_offset_ = gfx::Vector2dF();
+    press(WebInputEvent::Type::kMouseDown, fury_wheel_origin_);
+    fury_wheel_down_ = true;
+  }
+  fury_wheel_offset_ += gfx::Vector2dF(event.delta_x, event.delta_y);
+  if (fury_wheel_offset_.Length() > kLiftAfter) {
+    press(WebInputEvent::Type::kMouseUp, fury_wheel_origin_ + fury_wheel_offset_ - gfx::Vector2dF(event.delta_x, event.delta_y));
+    press(WebInputEvent::Type::kMouseDown, fury_wheel_origin_);
+    fury_wheel_offset_ = gfx::Vector2dF(event.delta_x, event.delta_y);
+  }
+  press(WebInputEvent::Type::kMouseMove, fury_wheel_origin_ + fury_wheel_offset_);
+  fury_wheel_lift_timer_.Start(
+      FROM_HERE, base::Milliseconds(150),
+      base::BindOnce(
+          [](TouchEmulatorImpl* self) {
+            if (!self->fury_wheel_down_ || !self->fury_wheel_view_) {
+              self->fury_wheel_down_ = false;
+              return;
+            }
+            WebMouseEvent up(WebInputEvent::Type::kMouseUp, 0,
+                             base::TimeTicks::Now());
+            up.button = WebMouseEvent::Button::kLeft;
+            up.click_count = 1;
+            gfx::PointF at = self->fury_wheel_origin_ + self->fury_wheel_offset_;
+            up.SetPositionInWidget(at);
+            up.SetPositionInScreen(at);
+            self->fury_wheel_down_ = false;
+            self->last_mouse_event_was_move_ = false;
+            self->HandleMouseEvent(up, self->fury_wheel_view_.get());
+          },
+          base::Unretained(this)));
+}
