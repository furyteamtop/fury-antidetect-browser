+// Patch 0132: a touchpad pinch on a phone persona is two fingers.
+//
+// A trackpad pinch reaches a desktop page as ctrl+wheel events and zooms the
+// page from the touchpad; a phone has neither. Here it is two fingers put
+// down either side of the pointer, moved apart or together by the gesture's
+// scale, and lifted at its end, through the same gesture provider as every
+// other emulated touch: the page sees touchstart with two touches and
+// touchmoves, and the zoom is Blink's own pinch of the visual viewport.
+bool TouchEmulatorImpl::HandleTouchpadZoomEvent(
+    const blink::WebGestureEvent& event,
+    input::RenderWidgetHostViewInput* target_view) {
+  if (!IsEnabled() || mode_ != Mode::kEmulatingTouchFromMouse) {
+    return false;
+  }
+  if (!fury_finger_ready_) {
+    FuryInitFinger();
+  }
+  if (!fury_finger_ || !target_view) {
+    return false;
+  }
+  switch (event.GetType()) {
+    case WebInputEvent::Type::kGesturePinchBegin:
+      if (mouse_pressed_ || fury_wheel_down_) {
+        return true;  // a finger is already down; a second gesture waits
+      }
+      FuryPinchBy(1.f, event.PositionInWidget(), target_view);
+      return true;
+    case WebInputEvent::Type::kGesturePinchUpdate:
+      FuryPinchBy(event.data.pinch_update.scale, event.PositionInWidget(),
+                  target_view);
+      return true;
+    case WebInputEvent::Type::kGesturePinchEnd:
+      FuryPinchEnd(target_view);
+      return true;
+    default:
+      // The touchpad's double-tap zoom: a phone double-taps with a finger,
+      // which the mouse already is.
+      return true;
+  }
+}
+
+void TouchEmulatorImpl::FuryPinchBy(float scale,
+                                    const gfx::PointF& at,
+                                    input::RenderWidgetHostViewInput* view) {
+  // The scale detector starts only once the fingers' span has changed by
+  // span_slop, and does not count that first part; below min_scaling_span it
+  // does not scale at all. Measured: a 2x touchpad pinch zoomed the page
+  // 1.2x. So the fingers go down wide enough and are spread past the slop
+  // straight away, and from there the page's zoom is the gesture's.
+  const ui::ScaleGestureDetector::Config& detector =
+      ui::GetGestureProviderConfig(gesture_provider_config_type_)
+          .scale_gesture_detector_config;
+  const float min_half = detector.min_scaling_span / 2.f + 2.f;
+  if (!fury_pinching_) {
+    fury_pinch_centre_ = at;
+    fury_pinch_half_ = std::max(60.f, min_half + 8.f);
+    fury_pinching_ = true;
+    FuryPinchFingers(WebInputEvent::Type::kTouchStart, 0, view);
+    FuryPinchFingers(WebInputEvent::Type::kTouchStart, 1, view);
+    fury_pinch_half_ += detector.span_slop / 2.f + 2.f;
+    FuryPinchFingers(WebInputEvent::Type::kTouchMove, -1, view);
+    if (scale == 1.f) {
+      return;
+    }
+  }
+  fury_pinch_half_ = std::clamp(fury_pinch_half_ * scale, min_half, 600.f);
+  FuryPinchFingers(WebInputEvent::Type::kTouchMove, -1, view);
+}
+
+void TouchEmulatorImpl::FuryPinchEnd(input::RenderWidgetHostViewInput* view) {
+  fury_pinch_lift_timer_.Stop();
+  if (!fury_pinching_ || !view) {
+    fury_pinching_ = false;
+    return;
+  }
+  FuryPinchFingers(WebInputEvent::Type::kTouchEnd, 1, view);
+  FuryPinchFingers(WebInputEvent::Type::kTouchEnd, 0, view);
+  fury_pinching_ = false;
+}
+
+// Two fingers either side of the pinch's centre, horizontally. `changed` is
+// the finger that went down or up; -1 for a move of both. A finger already
+// gone is not in the event, as on a real screen.
+void TouchEmulatorImpl::FuryPinchFingers(WebInputEvent::Type type,
+                                         int changed,
+                                         input::RenderWidgetHostViewInput* view) {
+  WebTouchEvent touch(type, WebInputEvent::kNoModifiers, base::TimeTicks::Now());
+  const bool second_present =
+      !(type == WebInputEvent::Type::kTouchStart && changed == 0) &&
+      !(type == WebInputEvent::Type::kTouchEnd && changed == 0);
+  touch.touches_length = second_present ? 2 : 1;
+  for (unsigned i = 0; i < touch.touches_length; ++i) {
+    WebTouchPoint& p = touch.touches[i];
+    p.id = static_cast<int>(i);
+    const float dx = (i == 0 ? -1.f : 1.f) * fury_pinch_half_;
+    const gfx::PointF at = fury_pinch_centre_ + gfx::Vector2dF(dx, 0) + fury_bias_;
+    gfx::PointF in_root = view->TransformPointToRootCoordSpaceF(at);
+    p.SetPositionInWidget(in_root);
+    p.SetPositionInScreen(at);
+    p.radius_x = fury_radius_base_;
+    p.radius_y = fury_radius_base_;
+    p.force = type == WebInputEvent::Type::kTouchEnd && static_cast<int>(i) == changed
+                  ? 0.f
+                  : fury_force_base_;
+    p.pointer_type = blink::WebPointerProperties::PointerType::kTouch;
+    if (type == WebInputEvent::Type::kTouchMove) {
+      p.state = WebTouchPoint::State::kStateMoved;
+    } else if (static_cast<int>(i) == changed) {
+      p.state = type == WebInputEvent::Type::kTouchStart
+                    ? WebTouchPoint::State::kStatePressed
+                    : WebTouchPoint::State::kStateReleased;
+    } else {
+      p.state = WebTouchPoint::State::kStateStationary;
+    }
+  }
+  HandleEmulatedTouchEvent(touch, view);
+}
