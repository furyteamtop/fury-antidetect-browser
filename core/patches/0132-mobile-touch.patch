+// Patch 0132: on a phone persona, the mouse becomes a finger.
+//
+// DevTools' "emit touch events for mouse", the browser-side TouchEmulator,
+// switched on from the config instead of over CDP: a click reaches the page
+// as touchstart/touchend and a tap, a drag as a touch scroll, and a mouse
+// moving with no button pressed reaches the page as nothing at all, because
+// a phone cannot hover. Pointer events report pointerType "touch". Patch 0130
+// already makes the page expect this (touch events, coarse pointer, no hover);
+// without it the page would see a touchscreen that only ever sends mouse
+// events, which no phone does.
+//
+// Per WebContents, after each committed main-frame navigation, because the
+// browser's own pages and DevTools are not the phone's content and are
+// operated with a mouse. The wheel still arrives as a wheel when no touch is
+// active (TouchEmulatorImpl::HandleMouseWheelEvent); turning it into a finger
+// drag is not done here.
+void WebContentsImpl::FuryUpdateTouchFromMouse(const GURL& url) {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || !config->GetBool("mobile.enabled").value_or(false)) {
+    return;
+  }
+  const bool browser_page = url.SchemeIs(kChromeUIScheme) ||
+                            url.SchemeIs(kChromeDevToolsScheme) ||
+                            url.SchemeIs(kChromeUIUntrustedScheme);
+  // The router owns what the emulator talks to; make sure it exists.
+  if (!GetInputEventRouter()) {
+    return;
+  }
+  auto* emulator = static_cast<TouchEmulatorImpl*>(GetTouchEmulator(/*create_if_necessary=*/true));
+  if (!emulator) {
+    return;
+  }
+  if (browser_page) {
+    emulator->Disable();
+    SetForceDisableOverscrollContent(false);
+  } else if (!emulator->IsEnabled()) {
+    emulator->Enable(input::TouchEmulator::Mode::kEmulatingTouchFromMouse,
+                     ui::GestureProviderConfigType::GENERIC_MOBILE);
+    SetForceDisableOverscrollContent(true);
+  }
+}
