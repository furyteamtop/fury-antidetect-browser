 namespace {
 
+// Patch 0305: a profile started in the background stays there until a person
+// takes it.
+//
+// Chrome opens its first window with SW_SHOWNORMAL on Windows and then calls
+// Activate() on it (HWNDMessageHandler::Show), so a profile an MCP client
+// starts for a script lands on top of whatever the person was doing and takes
+// the keyboard. The show state cannot be handed in from outside: Chrome reads
+// it from STARTUPINFO, and the stable Rust standard library the agent spawns
+// with has no way to set wShowWindow.
+//
+// With --fury-background-window every browser window of this process is shown
+// inactive, sent to the bottom of the z-order on Windows, and refuses to
+// activate itself, which covers a page's window.focus(), a new tab opening in
+// an existing window and CDP's Target.activateTarget. Tab switches still
+// happen: BrowserWebContentsDelegate::ActivateContents activates the tab
+// first and only then asks the window, so a script can still bring a tab
+// forward inside the window. The first time the person activates any of the
+// windows themselves (taskbar, click, Alt+Tab) the switch stops mattering for
+// the rest of the process's life.
+//
+// Being covered by other windows would normally mark the pages hidden and stop
+// them painting; the agent passes --disable-backgrounding-occluded-windows with
+// this switch so they keep rendering as a window on the screen does.
+bool g_fury_window_was_active = false;
+
+bool FuryKeepInBackground() {
+  return !g_fury_window_was_active &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch(
+             fury::switches::kBackgroundWindow);
+}
+
+void FurySendToBack(views::Widget* widget) {
+#if BUILDFLAG(IS_WIN)
+  ::SetWindowPos(views::HWNDForWidget(widget), HWND_BOTTOM, 0, 0, 0, 0,
+                 SWP_NOACTIVATE | SWP_NOMOVE | SWP_NOSIZE);
+#endif
+}
+
+}  // namespace
