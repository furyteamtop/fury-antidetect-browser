 const Vector<String>& NavigatorLanguage::languages() {
   EnsureUpdatedLanguage();
+  // Phase 0 measured this as a real difference between a clean Chromium and
+  // real Chrome: "ru-RU" against "ru-RU,ru,en-US,en". The list is also derived
+  // from the proxy country at profile level, so it must be settable outright.
+  //
+  // An empty configured list is rejected rather than honoured: no real browser
+  // reports zero languages, so obeying it would create the contradiction this
+  // whole patch series exists to avoid.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<std::vector<std::string>> langs =
+            config->GetStringList("navigator.languages")) {
+      if (!langs->empty()) {
+        languages_.clear();
+        languages_.reserve(static_cast<wtf_size_t>(langs->size()));
+        for (const std::string& lang : *langs) {
+          languages_.push_back(String::FromUtf8(lang));
+        }
+        languages_dirty_ = false;
+      }
+    }
+  }
   return languages_;
 }
 
