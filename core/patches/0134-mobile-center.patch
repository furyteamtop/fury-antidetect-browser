   gfx::Rect contents_view_bounds = non_devtools_contents_bounds;
 
+  // Patch 0134: on a phone persona the page is a phone-wide column in the
+  // middle of the window, as DevTools places a device in device mode, rather
+  // than a phone drawn at the left of a wider window (0131 gives the page the
+  // phone's screen whatever the window is, 0133 sizes the window, and macOS
+  // will not make it narrower than 500). Moving the view itself, not the
+  // drawing, keeps every click and touch where it lands with no coordinate
+  // mapping. Every page of the window gets the column, the browser's own
+  // included: in a phone-sized window that is what a page is.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get();
+      config && config->GetBool("mobile.enabled").value_or(false)) {
+    const int phone = config->GetInt("screen.width").value_or(0);
+    if (phone > 0 && phone < contents_view_bounds.width()) {
+      contents_view_bounds.set_x(contents_view_bounds.x() +
+                                 (contents_view_bounds.width() - phone) / 2);
+      contents_view_bounds.set_width(phone);
+    }
+  }
