+  // Fury: a key that travels with the profile rather than with the machine.
+  //
+  // Read here, immediately before the providers are built, because this is the
+  // only place that needs it — keeping it out of //content means keeping it out
+  // of the renderer's dependency graph entirely.
+  //
+  // Highest precedence of the lot, so it wins for encryption wherever it has a
+  // key. The platform providers stay registered below it and are still consulted
+  // for DECRYPTION: a profile written before this patch has "v10" cookies that
+  // must keep opening, and they do, because the tag stored with each value
+  // selects the key. Old rows convert to "f10" as the browser rewrites them.
+  fury::FuryKey::InitializeInBrowser();
+  providers.emplace_back(std::make_pair(
+      /*precedence=*/20u, std::make_unique<fury::FuryKeyProvider>()));
+
   if (additional_provider_for_test_) {
     // Explicitly move the KeyProvider but leave the std::optional holding the
     // pair, this ensures it can only be set once in testing.
