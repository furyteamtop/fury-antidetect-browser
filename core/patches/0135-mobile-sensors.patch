+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Copyright 2026 Bogdan Shapovalov and the Fury authors
+
+#ifndef CONTENT_BROWSER_GENERIC_SENSOR_FURY_PHONE_MOTION_H_
+#define CONTENT_BROWSER_GENERIC_SENSOR_FURY_PHONE_MOTION_H_
+
+#include <array>
+#include <memory>
+#include <random>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class GURL;
+
+namespace content {
+
+class ScopedVirtualSensorForDevTools;
+class WebContents;
+
+// Fury patch 0135: a phone persona's motion sensors (docs/18).
+//
+// A phone in a hand reports devicemotion about every 16 ms: gravity tilted
+// by how it is held, a hand tremor of a few hundredths of m/s^2, rotation of
+// a few degrees per second. A desktop has no such sensors and reports
+// nothing, which on a phone persona is a contradiction any page can read in
+// four seconds. This gives the tab the virtual sensors DevTools' sensor
+// emulation uses (accelerometer, linear acceleration, gravity, gyroscope,
+// relative and absolute orientation; the device service derives the
+// DeviceOrientation angles from the last two) and feeds them from one model
+// of a hand holding a phone, so every reading agrees with every other:
+// gravity is the orientation's, the rotation rate is the orientation's rate
+// of change.
+//
+// How the hand holds it (tilt, roll, sway, tremor) comes from the profile's
+// mobile.touchSeed, so a profile handles its phone the same way on every
+// launch and another profile its own way. The noise on top is new each time.
+class FuryPhoneMotion : public WebContentsObserver,
+                        public WebContentsUserData<FuryPhoneMotion> {
+ public:
+  ~FuryPhoneMotion() override;
+
+  // Attach to a phone persona's tab, or detach on the browser's own pages.
+  static void UpdateForNavigation(WebContents* web_contents, const GURL& url);
+
+ private:
+  friend class WebContentsUserData<FuryPhoneMotion>;
+  FuryPhoneMotion(WebContents* web_contents, uint64_t seed);
+
+  struct Orientation {
+    double alpha;  // degrees
+    double beta;
+    double gamma;
+  };
+
+  // The virtual sensors call into WebContentsSensorProviderProxy when they
+  // go, and that proxy is user data of the same WebContents, torn down in no
+  // particular order: released here, before any user data is. Measured: the
+  // core crashed on quit (EXC_BAD_ACCESS) whenever the proxy went first.
+  void WebContentsDestroyed() override;
+
+  Orientation OrientationAt(double t);
+  void Tick();
+
+  std::vector<std::unique_ptr<ScopedVirtualSensorForDevTools>> sensors_;
+  base::RepeatingTimer timer_;
+  base::TimeTicks start_;
+  double last_t_ = -1;
+  std::array<double, 9> last_rotation_{};
+
+  // From the seed: how this hand holds this phone.
+  double base_alpha_, base_beta_, base_gamma_;
+  // Per angle (alpha, beta, gamma), three sines each.
+  std::array<std::array<double, 3>, 3> sway_amp_;  // degrees
+  std::array<std::array<double, 3>, 3> sway_freq_;  // Hz
+  std::array<std::array<double, 3>, 3> sway_phase_;
+  double tremor_amp_;       // degrees
+  double tremor_freq_;      // Hz
+  double tremor_accel_;     // m/s^2
+  double sway_accel_;       // m/s^2
+  double sway_accel_freq_;  // Hz
+  double accel_noise_;      // m/s^2
+  double gyro_noise_;       // rad/s
+
+  // Slow wander on top of the sines (Ornstein-Uhlenbeck), and the noise.
+  std::array<double, 3> drift_{};
+  std::mt19937_64 rng_;
+  std::normal_distribution<double> normal_{0.0, 1.0};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_GENERIC_SENSOR_FURY_PHONE_MOTION_H_
diff --git a/content/browser/generic_sensor/fury_phone_motion.cc b/content/browser/generic_sensor/fury_phone_motion.cc
