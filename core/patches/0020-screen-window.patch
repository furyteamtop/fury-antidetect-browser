 double PaintWorkletGlobalScope::devicePixelRatio() const {
+  // Fury patch 0020: the persona's ratio, as window.devicePixelRatio says.
+  // Off the main thread this was the element's effective zoom, which carries
+  // the host screen's scale: a 2.8125 phone persona on a 2x Mac painted with
+  // devicePixelRatio 2 (measured 10.10.2026, by the width a paint() drew),
+  // and so would any persona whose ratio differs from the host's.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<double> ratio =
+            config->GetDouble("screen.devicePixelRatio");
+        ratio && *ratio > 0) {
+      return *ratio;
+    }
+  }
   return IsMainThread()
              ? GetFrame()->DevicePixelRatio()
              : PaintWorkletProxyClient::From(Clients())->DevicePixelRatio();
