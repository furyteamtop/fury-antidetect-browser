+
+  // screen.width, height, availWidth, availHeight, availLeft and availTop all
+  // read through here, so one override keeps all six mutually consistent.
+  // Overriding them getter by getter would make it possible to ship an
+  // availWidth larger than width — a contradiction no real display produces.
+  //
+  // Fields are applied independently: pinning the resolution while leaving the
+  // available area to the real machine is a legitimate combination.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    const std::optional<int> width = config->GetInt(
+        available ? "screen.availWidth" : "screen.width");
+    const std::optional<int> height = config->GetInt(
+        available ? "screen.availHeight" : "screen.height");
+    if (width && *width > 0) {
+      rect.set_width(*width);
+    }
+    if (height && *height > 0) {
+      rect.set_height(*height);
+    }
+    if (available) {
+      if (std::optional<int> left = config->GetInt("screen.availLeft")) {
+        rect.set_x(*left);
+      }
+      if (std::optional<int> top = config->GetInt("screen.availTop")) {
+        rect.set_y(*top);
+      }
+    } else {
+      // The screen rect is always at the origin; only the available rect is
+      // inset. A stale offset here would contradict the reported size.
+      rect.set_origin(gfx::Point());
