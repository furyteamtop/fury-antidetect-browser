+namespace {
+
+// Case-insensitive set of the families this profile is allowed to resolve.
+// Built once per process from the config; empty means "no restriction".
+std::string FuryLower(std::string_view in) {
+  std::string out(in);
+  for (char& c : out) {
+    if (c >= 'A' && c <= 'Z') {
+      c = static_cast<char>(c - 'A' + 'a');
+    }
+  }
+  return out;
+}
+
+const std::set<std::string>* FuryAllowedFonts() {
+  static const std::set<std::string>* allowed = [] {
+    auto* set = new std::set<std::string>();
+    if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+      if (std::optional<std::vector<std::string>> fonts =
+              config->GetStringList("fonts")) {
+        for (const std::string& name : *fonts) {
+          set->insert(FuryLower(name));
+        }
+      }
+    }
+    return set;
+  }();
+  return allowed->empty() ? nullptr : allowed;
+}
+
+// CSS generic families are keywords, not installed fonts. Blocking them would
+// leave a page with no text at all, and they carry no fingerprint of their own.
+bool FuryIsGenericFamily(const std::string& lower) {
+  return lower == "serif" || lower == "sans-serif" || lower == "monospace" ||
+         lower == "cursive" || lower == "fantasy" || lower == "system-ui" ||
+         lower == "-webkit-body" || lower == "-webkit-standard" ||
+         lower == "ui-serif" || lower == "ui-sans-serif" ||
+         lower == "ui-monospace" || lower == "ui-rounded" ||
+         lower == "math" || lower == "emoji" || lower == "fangsong";
+}
+
+}  // namespace
+
+// Set while Blink is asking for its floor — the font it falls back to when every
+// family a page named has failed. Not in the anonymous namespace above because
+// the two hooks below have external linkage and must touch the same object.
+namespace {
+thread_local bool g_fury_in_last_resort = false;
+}
+
+namespace fury_internal {
+
+// Each platform picks its own last-resort families and asks for them by name:
+// macOS wants Times and then Lucida Grande, the Skia backends want a list of
+// their own, and none of them agree on which AlternateFontName they pass. A
+// name-based or enum-based exemption therefore only ever fixes one platform —
+// the first attempt exempted AlternateFontName::kLastResort and did nothing on
+// macOS, where GetLastResortFallbackFont passes kAllowAlternate.
+//
+// So the exemption is a flag set around the call instead. It cannot be reached
+// from a page: only FontFallbackList sets it, and only after every family the
+// document asked for has already been refused.
+void EnterLastResort() {
+  g_fury_in_last_resort = true;
+}
+void LeaveLastResort() {
+  g_fury_in_last_resort = false;
+}
+
+}  // namespace fury_internal
