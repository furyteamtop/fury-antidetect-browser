 const SimpleFontData* FontCache::GetFontData(
     const FontDescription& font_description,
     const AtomicString& family,
     AlternateFontName altername_font_name) {
+  // Filtering happens HERE, at resolution, not at any enumeration API.
+  //
+  // Measured with the detect-suite: document.fonts.check() returns true for
+  // arbitrary family names in real Chrome — including
+  // "ThisFontDoesNotExistAnywhere12345" — so it is not a detection method and
+  // filtering it would achieve nothing. Real detection is measurement: render
+  // text in the candidate family with a known fallback and compare widths. A
+  // font that still resolves is still detected, however well the enumeration
+  // API is filtered.
+  //
+  // Returning nullptr makes Blink fall back exactly as it does on a machine
+  // where the family is genuinely absent, so measurement and enumeration agree
+  // by construction.
+  //
+  // Fonts loaded by the page itself through @font-face do not come through
+  // here, so sites keep their own typefaces.
+  //
+  // The last-resort lookup is exempt, and that exemption is load-bearing.
+  // GetLastResortFallbackFont asks for concrete families by name — Times, Segoe
+  // UI, whatever the platform's floor happens to be — and a profile whose list
+  // does not contain them would have every one of those refused too. Blink is
+  // then left with no font at all and simply draws nothing: found by running a
+  // Windows profile on a macOS host, where a page asking for a monospace family
+  // rendered its labels and not its values. Any dashboard showing keys, IPs or
+  // code would be blank, and a browser where a family resolves to nothing is
+  // not behaving like an ordinary one either.
+  //
+  // So: a filter may narrow, never to zero. Same rule as the speech-voice
+  // filter in 0041, for the same reason.
+  if (altername_font_name != AlternateFontName::kLastResort &&
+      !g_fury_in_last_resort) {
+    if (const std::set<std::string>* allowed = FuryAllowedFonts()) {
+      const std::string lower = FuryLower(family.Utf8());
+      if (!FuryIsGenericFamily(lower) && !allowed->count(lower)) {
+        return nullptr;
+      }
+    }
+  }
