 namespace blink {
 
+namespace fury_internal {
+// Defined in font_cache.cc. Suspends the profile's font filter for the duration
+// of a last-resort lookup: each platform names its own floor fonts, and refusing
+// those leaves Blink with nothing to draw with at all.
+void EnterLastResort();
+void LeaveLastResort();
+
+// RAII so an early return cannot leave the filter switched off.
+class ScopedLastResort {
+ public:
+  ScopedLastResort() { EnterLastResort(); }
+  ~ScopedLastResort() { LeaveLastResort(); }
+};
+}  // namespace fury_internal
