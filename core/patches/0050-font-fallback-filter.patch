+namespace fury_internal {
+// Defined in font_cache.cc. Suspends the profile's font filter while Blink
+// resolves a family the PAGE did not name: its last-resort floor, whose fonts
+// each platform picks for itself, and the concrete font behind a generic
+// keyword, which style resolution has already substituted by the time the
+// filter sees it. Refusing either leaves Blink with nothing to draw with —
+// and, for the generics, leaves serif, monospace and cursive all rendering in
+// the same face, which is a machine that does not exist.
+void SuspendFilter();
+void ResumeFilter();
+
+// RAII so an early return cannot leave the filter switched off.
+class ScopedFilterSuspend {
+ public:
+  ScopedFilterSuspend() { SuspendFilter(); }
+  ~ScopedFilterSuspend() { ResumeFilter(); }
+};
+}  // namespace fury_internal
