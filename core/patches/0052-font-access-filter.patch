+// The rule without the two exemptions ShouldHideFont carries. Both are about
+// Blink resolving a family the page did not name -- its last-resort floor, the
+// face behind a generic keyword -- and neither applies to a list handed to the
+// page, where every entry is a name the page can then ask for. The generic
+// keywords stay exempt only because they are not families anyone installs.
+bool FuryFontHiddenFromPage(const String& family) {
   if (const FuryFontRule* rule = FuryFonts()) {
     const std::string lower = FuryLower(family.Utf8());
     const bool listed = rule->names.count(lower) > 0;
