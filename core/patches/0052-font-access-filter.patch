+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FURY_FONT_FILTER_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FURY_FONT_FILTER_H_
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+// Whether the profile's font rule hides `family` from pages: the same rule
+// FontCache applies when a page names a family (0050, 0051), exposed for the
+// places that LIST fonts instead of resolving them. Local Font Access is the
+// one that matters: once a page holds the local-fonts permission,
+// queryLocalFonts() hands it the machine's whole list, and a family the
+// rendering path refuses must not be in it. Defined in font_cache.cc, next to
+// the rule.
+PLATFORM_EXPORT bool FuryFontHiddenFromPage(const String& family);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FURY_FONT_FILTER_H_
