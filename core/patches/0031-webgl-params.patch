+// Maps the GLenum a page passes to getParameter() onto the name the config uses.
+//
+// Intercepting once at the top of getParameter() rather than case by case is
+// deliberate: the switch below has around eighty arms, and patching them
+// individually would guarantee some are missed at the next rebase — and a
+// single un-spoofed limit contradicts every spoofed one around it.
+//
+// Names match what tools/detect-suite/probe.js dumps, so a persona can be
+// filled straight from a capture of a real machine.
+struct FuryGlParamName {
+  GLenum pname;
+  const char* name;
+};
+
+constexpr FuryGlParamName kFuryGlIntParams[] = {
+    {GL_MAX_TEXTURE_SIZE, "MAX_TEXTURE_SIZE"},
+    {GL_MAX_RENDERBUFFER_SIZE, "MAX_RENDERBUFFER_SIZE"},
