+    {GL_MAX_TEXTURE_IMAGE_UNITS, "MAX_TEXTURE_IMAGE_UNITS"},
+    {GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS, "MAX_VERTEX_TEXTURE_IMAGE_UNITS"},
+    {GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, "MAX_COMBINED_TEXTURE_IMAGE_UNITS"},
+    {GL_MAX_VERTEX_ATTRIBS, "MAX_VERTEX_ATTRIBS"},
+    {GL_MAX_VERTEX_UNIFORM_VECTORS, "MAX_VERTEX_UNIFORM_VECTORS"},
+    {GL_MAX_FRAGMENT_UNIFORM_VECTORS, "MAX_FRAGMENT_UNIFORM_VECTORS"},
+    {GL_MAX_VARYING_VECTORS, "MAX_VARYING_VECTORS"},
+    {GL_RED_BITS, "RED_BITS"},
+    {GL_GREEN_BITS, "GREEN_BITS"},
+    {GL_BLUE_BITS, "BLUE_BITS"},
+    {GL_DEPTH_BITS, "DEPTH_BITS"},
+    {GL_STENCIL_BITS, "STENCIL_BITS"},
+    {GL_SUBPIXEL_BITS, "SUBPIXEL_BITS"},
+    {GL_SAMPLE_BUFFERS, "SAMPLE_BUFFERS"},
+    {GL_SAMPLES, "SAMPLES"},
+};
+
+constexpr FuryGlParamName kFuryGlStringParams[] = {
+    {GL_VENDOR, "VENDOR"},
+    {GL_RENDERER, "RENDERER"},
+    {GL_VERSION, "VERSION"},
+    {GL_SHADING_LANGUAGE_VERSION, "SHADING_LANGUAGE_VERSION"},
+    {WebGLDebugRendererInfo::kUnmaskedVendorWebgl, "UNMASKED_VENDOR_WEBGL"},
+    {WebGLDebugRendererInfo::kUnmaskedRendererWebgl, "UNMASKED_RENDERER_WEBGL"},
+};
+
+// Reported as Float32Array, so the config stores them comma-separated.
+constexpr FuryGlParamName kFuryGlFloatArrayParams[] = {
+    {GL_ALIASED_LINE_WIDTH_RANGE, "ALIASED_LINE_WIDTH_RANGE"},
+    {GL_ALIASED_POINT_SIZE_RANGE, "ALIASED_POINT_SIZE_RANGE"},
+};
+
+// Reported as Int32Array — same storage, different JS type, and the type is
+// itself a fingerprint. MAX_VIEWPORT_DIMS answers an Int32Array on every real
+// WebGL implementation, so handing back a Float32Array names this build in one
+// line of script: a worse tell than the value it was hiding. It sat in the
+// float table above until the config-key audit went looking for exactly this.
+constexpr FuryGlParamName kFuryGlIntArrayParams[] = {
+    {GL_MAX_VIEWPORT_DIMS, "MAX_VIEWPORT_DIMS"},
+};
+
+const char* FuryFindName(base::span<const FuryGlParamName> table, GLenum pname) {
+  for (const auto& entry : table) {
+    if (entry.pname == pname) {
+      return entry.name;
+    }
+  }
+  return nullptr;
+}
