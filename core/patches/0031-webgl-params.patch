+// The persona's extension list for this kind of context. A WebGL1 and a
+// WebGL2 context list different extensions on the same machine -- WebGL2 has
+// its own (EXT_color_buffer_float, OES_draw_buffers_indexed) and drops the
+// ones it made core -- so one list for both left a WebGL2 context with only
+// the names the two shared: 18 where Chrome on the same Windows machine lists
+// 32 (ctx-fury baseline). gpu.webglExtensions is what a persona without
+// per-context lists carries, and what an older agent sends.
+std::optional<std::vector<std::string>> FuryExtensionList(
+    const fury::FuryConfig& config,
+    bool webgl2) {
+  std::optional<std::vector<std::string>> list =
+      webgl2 ? config.GetStringList("gpu.webgl2Extensions")
+             : config.GetStringList("gpu.webgl1Extensions");
+  if (!list) {
+    list = config.GetStringList("gpu.webglExtensions");
+  }
+  return list;
+}
