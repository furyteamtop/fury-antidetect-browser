+// Patch 0130: a phone held the way its screen is shaped. The host's display
+// is a landscape monitor, and screen.orientation would say so next to a
+// 384x832 screen.width/height (patch 0020) on the same object's owner.
+// Natural orientation, angle 0, which is how a phone sits in the hand.
+std::optional<bool> FuryPortrait() {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || !config->GetBool("mobile.enabled").value_or(false)) {
+    return std::nullopt;
+  }
+  std::optional<int> width = config->GetInt("screen.width");
+  std::optional<int> height = config->GetInt("screen.height");
+  if (!width || !height) {
+    return std::nullopt;
+  }
+  return *height >= *width;
+}
