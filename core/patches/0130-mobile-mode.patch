     const base::CommandLine& command_line) {
   // Sets experimental features.
@@ -595,6 +646,8 @@ void SetRuntimeFeaturesDefaultsAndUpdateFromArgs(
     WebRuntimeFeatures::EnableXSLT(value == "true");
   }
 
+  SetFuryMobileRuntimeFeatures();
+
