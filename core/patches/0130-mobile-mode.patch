 namespace content {
 
+// Patch 0130: the web platform of Chrome on Android, in a phone persona's
+// processes (docs/18).
+//
+// The lists are runtime_enabled_features.json5 itself, read on 155.0.8059.39:
+// every web-visible feature whose status is "stable" by default and not on
+// Android is switched off, and the ones stable on Android and not on desktop
+// are switched on where Blink alone implements them. A page that probes for
+// `queryLocalFonts`, `PressureObserver`, `documentPictureInPicture` or
+// `new Notification()` gets the phone's answer rather than the Mac's.
+//
+// Process-wide is right here and would be wrong in Chrome: a Fury browser is
+// one profile, so every renderer it starts belongs to the same phone. And it
+// is done here, after the command line, rather than with
+// --enable/--disable-blink-features: no persona value goes into any process's
+// argv (README, the Windows launcher), and this is the code those switches
+// call anyway.
+//
+// Left off on purpose although Android has them: ContactsManager, WebNFC,
+// DigitalGoods, ContentIndex, DisplayCutoutAPI. Their interfaces are bound by
+// the browser only on Android, and a desktop browser answers a request for an
+// unbound interface by killing the renderer that made it. A page calling
+// navigator.contacts.select() would close the tab, which is louder than the
+// interface being absent. They need stub binders first.
+namespace {
+
+void SetFuryMobileRuntimeFeatures() {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || !config->GetBool("mobile.enabled").value_or(false)) {
+    return;
+  }
+  for (const char* off : {
+           "AudioOutputDevices", "CaptureController", "CapturedSurfaceControl",
+           "CaptureHandle", "ComputePressure", "DocumentPictureInPictureAPI",
+           "DocumentPictureInPicturePreferInitialPlacement",
+           "DocumentPictureInPictureUserActivation", "FontAccess",
+           "GetDisplayMedia", "NavigatorContentUtils", "NotificationConstructor",
+           "WebHID"}) {
+    WebRuntimeFeatures::EnableFeatureFromString(off, false);
+  }
+  // MobileLayoutTheme is Android's look for form controls and the one
+  // DevToolsEmulator switches on; the sizes of a default <input> and <select>
+  // are measurable, and a desktop theme under a phone persona is a mismatch.
+  for (const char* on : {"NetInfoDownlinkMax", "OrientationEvent",
+                         "TouchEventFeatureDetection", "MobileLayoutTheme"}) {
+    WebRuntimeFeatures::EnableFeatureFromString(on, true);
+  }
+}
+
+}  // namespace
