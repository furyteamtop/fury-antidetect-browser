+         url.SchemeIs(content::kChromeDevToolsScheme) ||
+         url.SchemeIs(content::kChromeUIUntrustedScheme);
+}
+
+// The layout half of a phone: the layout viewport and <meta viewport>,
+// Android's 0.25-5 page scale range (with the desktop minimum of 1 a page
+// with no <meta viewport> cannot be shown whole, so Blink kept the layout at
+// the window's width instead of Android's 980; measured 500), resizes as
+// rotations. `phone` false puts back what a desktop WebPreferences has.
+// Returns whether anything changed, for OverrideWebPreferencesAfterNavigation.
+bool FuryMobileLayout(WebPreferences* p, bool phone) {
+  const WebPreferences desktop;
+  const WebPreferences before = *p;
+  p->viewport_enabled = phone || desktop.viewport_enabled;
+  p->viewport_meta_enabled = phone || desktop.viewport_meta_enabled;
+  p->shrinks_viewport_contents_to_fit =
+      phone || desktop.shrinks_viewport_contents_to_fit;
+  p->viewport_style =
+      phone ? blink::mojom::ViewportStyle::kMobile : desktop.viewport_style;
+  p->main_frame_resizes_are_orientation_changes =
+      phone || desktop.main_frame_resizes_are_orientation_changes;
+  p->double_tap_to_zoom_enabled = phone || desktop.double_tap_to_zoom_enabled;
+  p->text_size_adjust_enabled = phone || desktop.text_size_adjust_enabled;
+  // 0.25 is WebPreferences::kDefaultMinimumPageScaleFactor, which exists
+  // only in an Android build.
+  p->default_minimum_page_scale_factor =
+      phone ? 0.25f : desktop.default_minimum_page_scale_factor;
+  p->default_maximum_page_scale_factor =
+      phone ? 5.f : desktop.default_maximum_page_scale_factor;
+  return p->viewport_enabled != before.viewport_enabled ||
+         p->viewport_meta_enabled != before.viewport_meta_enabled ||
+         p->shrinks_viewport_contents_to_fit !=
+             before.shrinks_viewport_contents_to_fit ||
+         p->viewport_style != before.viewport_style ||
+         p->main_frame_resizes_are_orientation_changes !=
+             before.main_frame_resizes_are_orientation_changes ||
+         p->double_tap_to_zoom_enabled != before.double_tap_to_zoom_enabled ||
+         p->text_size_adjust_enabled != before.text_size_adjust_enabled ||
+         p->default_minimum_page_scale_factor !=
+             before.default_minimum_page_scale_factor ||
+         p->default_maximum_page_scale_factor !=
+             before.default_maximum_page_scale_factor;
+}
