+bool FuryIsBrowserPage(content::WebContents* web_contents) {
+  const GURL& url = web_contents->GetLastCommittedURL().is_empty()
+                        ? web_contents->GetVisibleURL()
+                        : web_contents->GetLastCommittedURL();
