+// Patch 0133: the outer size of a normal browser window on a phone persona.
+//
+// Patch 0131 gives the page the phone's screen whatever the window is, and
+// draws it at the window's top-left; without this the phone sat in the
+// corner of a desktop-sized window, or ran off the bottom of a short one.
+// Width: the phone plus a margin, and the platform clamps it to its minimum
+// (500 on macOS). Height: what the page lays out in (screen less the phone's
+// own browser chrome, screen.chromeHeightDelta), plus this browser's tab strip
+// and toolbar, 87 on macOS by verify-0902, plus a margin so an infobar does not
+// push the phone's bottom out of sight.
+// static
+std::optional<gfx::Size> WindowSizer::FuryPhoneWindowSize() {
+  const fury::FuryConfig* config = fury::FuryConfig::Get();
+  if (!config || !config->GetBool("mobile.enabled").value_or(false)) {
+    return std::nullopt;
+  }
+  std::optional<int> width = config->GetInt("screen.width");
+  std::optional<int> height = config->GetInt("screen.height");
+  if (!width || !height || *width <= 0 || *height <= 0) {
+    return std::nullopt;
+  }
+  const int phone_chrome =
+      std::max(0, config->GetInt("screen.chromeHeightDelta").value_or(0));
+  constexpr int kBrowserChrome = 87;
+  constexpr int kMargin = 24;
+  return gfx::Size(*width + 2 * kMargin,
+                   std::max(1, *height - phone_chrome) + kBrowserChrome + kMargin);
+}
