 bool ScrollbarThemeMac::UsesOverlayScrollbars() const {
+  // Overlay scrollbars take no space in layout, which is precisely why macOS
+  // measures 0. Setting a non-zero width therefore has to turn them off as
+  // well — a width that layout never reserves is not a width.
+  //
+  // The two must stay in agreement: reporting a 15 px thickness while still
+  // compositing an overlay would leave the measured value at 0 and contradict
+  // the claim.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<int> width = config->GetInt("screen.scrollbarWidth")) {
+      return *width == 0;
+    }
+  }
   return PreferOverlayScrollerStyle();
 }
 
