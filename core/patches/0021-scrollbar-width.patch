 bool ScrollbarThemeFluent::UsesOverlayScrollbars() const {
+  // Overlay scrollbars take no space in layout, so a configured width that
+  // layout never reserves is not a width at all and the page still measures 0.
+  // The pair must move together, exactly as in ScrollbarThemeMac.
+  //
+  // UsesFluentOverlayScrollbars() is defined as this function, so it follows
+  // without a second override.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<int> width = config->GetInt("screen.scrollbarWidth")) {
+      return *width == 0;
+    }
+  }
   return OverlayScrollbarsEnabled();
 }
 
