 #include <algorithm>
 
 #include "base/numerics/checked_math.h"
@@ -72,6 +74,27 @@ constexpr uint64_t UndefinedLimitValue<uint64_t>() {
 
 GPUSupportedLimits::GPUSupportedLimits(const ComboLimits& limits) {
   limits.UnlinkedCopyTo(&limits_);
+
+  // Driven by the same SUPPORTED_LIMITS X-macro the getters use, so a limit
+  // Chromium adds upstream is covered here the moment it appears in that list
+  // — no separate table to fall out of date at rebase time.
+  //
+  // This is the vector docs/08 measured AdsPower leaving open: it rewrites the
+  // WebGL renderer string and leaves adapter.limits describing the real GPU, so
+  // the two disagree about what card this is. Limits are read as doubles
+  // because several are uint64_t and JSON has one numeric type; the mantissa is
+  // wide enough for every value WebGPU reports.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+#define FURY_APPLY_LIMIT(name)                                             \
+  if (std::optional<double> fury_value =                                   \
+          config->GetDouble("gpu.webgpu.limits." #name)) {                 \
+    if (*fury_value >= 0) {                                                \
+      limits_.name = static_cast<decltype(limits_.name)>(*fury_value);     \
+    }                                                                      \
+  }
+    SUPPORTED_LIMITS(FURY_APPLY_LIMIT)
+#undef FURY_APPLY_LIMIT
+  }
 }
 
