+  // Kept in step with permissions.query({name:"notifications"}) in patch 0090.
+  //
+  // Found by measurement, not foresight: overriding only the Permissions API
+  // produced query="denied" against Notification.permission="default" — a
+  // genuine contradiction, and precisely the headless tell the detect-suite
+  // gate was written to catch. The persona would have been shooting itself in
+  // the foot.
+  //
+  // The two APIs use different words for the same states — Permissions says
+  // prompt, Notification says default — so the mapping happens here rather than
+  // by forcing a shared literal.
+  if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+    if (std::optional<std::string> want =
