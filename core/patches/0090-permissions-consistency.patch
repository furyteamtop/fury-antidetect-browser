+// Config key for a permission, or nullptr for ones a persona has no business
+// setting. Names match what the Permissions API accepts in JS and what
+// tools/detect-suite/probe.js queries, so a persona can be filled from a
+// capture.
+const char* FuryPermissionConfigKey(mojom::blink::PermissionName name) {
+  using mojom::blink::PermissionName;
+  switch (name) {
+    case PermissionName::GEOLOCATION:
+      return "geolocation";
+    case PermissionName::NOTIFICATIONS:
+      return "notifications";
+    case PermissionName::AUDIO_CAPTURE:
+      return "microphone";
+    case PermissionName::VIDEO_CAPTURE:
+      return "camera";
+    case PermissionName::MIDI:
+      return "midi";
+    case PermissionName::CLIPBOARD_READ:
+      return "clipboard-read";
+    case PermissionName::CLIPBOARD_WRITE:
+      return "clipboard-write";
+    case PermissionName::PERSISTENT_STORAGE:
+      return "persistent-storage";
+    case PermissionName::LOCAL_FONTS:
+      // Real Chrome gates queryLocalFonts() behind this, and patch 0050 makes
+      // the font list a persona property — so the permission that guards the
+      // enumeration API belongs to the persona too.
+      return "local-fonts";
+    default:
+      return nullptr;
+  }
+}
