   mojom::blink::PermissionStatus status =
       NotificationManager::From(context)->GetPermissionStatus();
 
+  // Kept in step with permissions.query({name:"notifications"}) in patch 0090.
+  //
+  // Found by measurement, not foresight: overriding only the Permissions API
+  // produced query="denied" against Notification.permission="default" — a
+  // genuine contradiction, and precisely the headless tell the detect-suite
+  // gate was written to catch. The persona would have been shooting itself in
+  // the foot.
+  //
+  // The two APIs use different words for the same states — Permissions says
+  // prompt, Notification says default — so the mapping happens here rather than
+  // by forcing a shared literal.
+  //
+  // Only while the real state is still ASK. The persona describes the profile
+  // nobody has answered a prompt in yet, not a permanent answer: once the user
+  // clicks Allow or Block, that decision is the truth and overriding it would
+  // be the contradiction, not the fix. See the same guard in permissions.cc.
+  if (status == mojom::blink::PermissionStatus::ASK) {
+    if (const fury::FuryConfig* config = fury::FuryConfig::Get()) {
+      if (std::optional<std::string> want =
+              config->GetString("permissions.notifications")) {
+        if (*want == "granted") {
+          status = mojom::blink::PermissionStatus::GRANTED;
+        } else if (*want == "denied") {
+          status = mojom::blink::PermissionStatus::DENIED;
+        } else if (*want == "prompt") {
+          status = mojom::blink::PermissionStatus::ASK;
+        }
+      }
+    }
+  }
+
   // Permission can only be requested from top-level frames and same-origin
   // iframes. This should be reflected in calls getting permission status.
   //
