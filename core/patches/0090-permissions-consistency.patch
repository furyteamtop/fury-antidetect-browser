+        status = mojom::blink::PermissionStatus::GRANTED;
+      } else if (*want == "denied") {
+        status = mojom::blink::PermissionStatus::DENIED;
+      } else if (*want == "prompt") {
+        status = mojom::blink::PermissionStatus::ASK;
+      }
+    }
+  }
