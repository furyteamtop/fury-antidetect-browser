+bool ShouldHideFont(const AtomicString& family, AlternateFontName alternate) {
+  if (alternate == AlternateFontName::kLastResort ||
+      g_fury_filter_suspended != 0) {
+    return false;
+  }
+  if (const FuryFontRule* rule = FuryFonts()) {
+    const std::string lower = FuryLower(family.Utf8());
+    const bool listed = rule->names.count(lower) > 0;
+    return !FuryIsGenericFamily(lower) && listed == rule->blocklist;
+  }
+  return false;
+}
