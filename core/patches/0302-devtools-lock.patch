@@ -10,5 +10,10 @@ namespace switches {
 const char kFingerprintFd[] = "fury-fp-fd";
 const char kFingerprintHandle[] = "fury-fp-handle";
 
+// Must match agent/src/launcher.rs. Nothing in either language checks the other,
